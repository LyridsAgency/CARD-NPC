{%- comment -%}
  ECRU — Carte 3D réutilisable (accueil, pages produit, configurateur).

  Paramètres :
  - id (obligatoire) : identifiant unique
  - elements : éléments du recto en JSON (textes, logos, positions de 0 à 1), vide = carte vierge
  - inlay : 'aucune' pour retirer la fenêtre NFC (présente par défaut)
  - color, ink : couleur de la carte et du marquage
  - finish : 'metal' ou 'mat'
  - poster : image de secours (image Shopify), sinon rendu par défaut
  - alt : description de la carte
  - avantages : liste séparée par « | » (5 max), affichée avec des flèches au survol
  - compact : true pour une scène moins haute (pages produit)
  - pose : « angle,inclinaison,zoom » pour une vue fixe
  - auto_open : true pour afficher les avantages dès l'arrivée (ordinateur)

  La scène three.js (assets/ecru-carte-3d.js) n'est chargée qu'à l'approche de la carte.
  Mise à jour en direct : el.dispatchEvent(new CustomEvent('ecru:card-update', { detail: { color, ink, finish, elements } }))
  Point de vue : el.dispatchEvent(new CustomEvent('ecru:view', { detail: { view: 'recto' | 'verso' | 'profil' | 'auto' } }))
{%- endcomment -%}
{%- liquid
  assign finish = finish | default: 'metal'
  assign alt = alt | default: 'Carte NFC ECRU en métal noir.'
  assign items = avantages | split: '|'
-%}
{{ 'ecru-carte.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ecru-carte-loader.js' | asset_url }}" defer="defer"></script>

<div
  id="{{ id }}"
  class="ecru-carte{% if compact %} ecru-carte--compact{% endif %}"
  {% if auto_open %}data-auto-open{% endif %}
  data-ecru-carte
  data-module="{{ 'ecru-carte-3d.js' | asset_url }}"
  data-font="{{ 'archivo-black.woff2' | asset_url }}"
  data-font-body="{{ 'inter-500.woff2' | asset_url }}"
  data-elements="{{ elements | default: '[]' | escape }}"
  data-inlay="{{ inlay | default: 'carre' }}"
  data-color="{{ color | default: '#0d0d0c' }}"
  data-ink="{{ ink | default: '#e9e4d8' }}"
  data-finish="{{ finish }}"
  {% if pose %}data-pose="{{ pose }}"{% endif %}
>
  <div class="ecru-carte__scene">
    <div class="ecru-carte__vue" data-ecru-stage>
      <div class="ecru-carte__affiche">
        {%- if poster != blank -%}
          {{
            poster
            | image_url: width: 1800
            | image_tag:
              widths: '600, 900, 1200, 1800',
              sizes: '(min-width: 990px) 70vw, 100vw',
              alt: alt,
              class: 'ecru-carte__affiche-img'
          }}
        {%- else -%}
          <img
            class="ecru-carte__affiche-img"
            src="{{ 'ecru-carte-secours.webp' | asset_url }}"
            alt="{{ alt | escape }}"
            width="1600"
            height="1052"
            fetchpriority="high"
            decoding="async"
          >
        {%- endif -%}
      </div>
      {%- if items.size > 0 -%}
        <svg class="ecru-carte__fleches" aria-hidden="true" focusable="false"></svg>
      {%- endif -%}
    </div>

    {%- if items.size > 0 -%}
      <ul class="ecru-carte__avantages" id="{{ id }}-avantages" role="list">
        {%- for item in items limit: 5 -%}
          <li class="ecru-carte__avantage" style="--i: {{ forloop.index0 }}">
            <span class="ecru-carte__num" aria-hidden="true">0{{ forloop.index }}</span>
            <span class="ecru-carte__libelle">{{ item | strip | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

</div>
