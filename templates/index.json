    "faq": {
      "type": "ecru-faq",
      "settings": {
        "heading": "Simple, vraiment.",
        "contact_label": "Une autre question",
        "surface": false
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Mes clients doivent-ils installer une application ?",
            "answer": "<p>Non. Ils approchent la carte de leur téléphone et la page s'ouvre. C'est tout.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Quels téléphones peuvent la lire ?",
            "answer": "<p>La plupart des smartphones récents lisent le NFC. Sur certains modèles Android, le NFC doit être activé dans les réglages.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Y a-t-il un minimum de commande ?",
            "answer": "<p>10 cartes pour les cartes simples, noires ou blanches. 100 cartes pour le sur mesure, avec ou sans l’option fidélité.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "Cartes simples, sur mesure, fidélité : quelle différence ?",
            "answer": "<p><strong>Cartes simples</strong> : noires ou blanches, sans marquage, elles ouvrent vos liens. <strong>Sur mesure</strong> : votre couleur, votre texte et votre logo, au recto comme au verso. <strong>Option fidélité</strong> : elle s’ajoute au sur mesure et transforme vos cartes en programme de fidélité. Tout est détaillé sur la <a href=\"/pages/fidelite\">page Fidélité</a>.</p>"
          }
        },
        "q9": {
          "type": "question",
          "settings": {
            "question": "Comment résilier l'abonnement Fidélité ?",
            "answer": "<p>Depuis votre <a href=\"/account\">compte client</a>, rubrique Abonnements, quand vous voulez. Une fois l'abonnement arrêté, vos cartes n'ouvrent plus votre page : elles affichent « Ce programme n'est plus actif ».</p>"
          }
        }
      },
      "block_order": [
        "q1",
