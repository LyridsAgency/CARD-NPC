    "faq": {
      "type": "ecru-faq",
      "settings": {
        "heading": "Simple, vraiment.",
        "contact_label": "Une autre question",
        "surface": false
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Mes clients doivent-ils installer une application ?",
            "answer": "<p>Non. Ils approchent la carte de leur téléphone et la page s'ouvre. C'est tout.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Quels téléphones peuvent la lire ?",
            "answer": "<p>La plupart des smartphones récents lisent le NFC. Sur certains modèles Android, le NFC doit être activé dans les réglages.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "La carte a-t-elle une batterie ?",
            "answer": "<p>Non. La puce NFC est passive : elle fonctionne sans batterie ni recharge.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Quelle taille fait la carte ?",
            "answer": "<p>Le format carte bancaire : 85,6 × 54 mm. Elle se glisse dans tous les portefeuilles.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Puis-je avoir ma couleur, mon nom, mon logo ?",
            "answer": "<p>Oui, avec « Sur mesure » : choisissez la couleur, placez votre nom et votre logo où vous voulez, et voyez le résultat en 3D avant de commander.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Y a-t-il un minimum de commande ?",
            "answer": "<p>10 cartes pour le noir et le blanc, vierges. 100 cartes pour le sur mesure.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "Quelle différence entre Fidélité et Cartes simples ?",
            "answer": "<p>Fidélité, c'est le programme complet : cartes, récompenses, suivi et rapport mensuel, avec un abonnement. Cartes simples, c'est une carte qui ouvre le lien de votre choix.</p>"
          }
        },
        "q8": {
          "type": "question",
          "settings": {
            "question": "J'ai une demande particulière.",
            "answer": "<p>Événement, grande quantité, finition à part : <a href=\"/pages/demande-particuliere\">écrivez-nous</a>, nous étudions chaque demande.</p>"
          }
        }
      },
