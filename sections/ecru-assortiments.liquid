{%- comment -%}
  ECRU — Modèles sur mesure : des cartes déjà composées, aux couleurs de la marque.
  Chaque modèle ouvre le configurateur déjà réglé (paramètre ?modele=), tout reste modifiable.
{%- endcomment -%}
{%- liquid
  assign lien = section.settings.button_link | default: routes.all_products_collection_url
  assign sep = '?'
  if lien contains '?'
    assign sep = '&'
  endif
-%}
<section
  class="ecru-section ecru-assortiments-section"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
>
  <div class="ecru-conteneur">
    <header class="ecru-entete ecru-assortiments-section__entete">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="titre-{{ section.id }}" class="ecru-titre ecru-reveal">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="ecru-texte ecru-reveal">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="ecru-bouton ecru-reveal" href="{{ lien }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </header>

    <ul class="ecru-modeles-vitrine" role="list">
      {%- for block in section.blocks -%}
        <li class="ecru-reveal" style="--d: {{ forloop.index0 | modulo: 3 }}" {{ block.shopify_attributes }}>
          <a class="ecru-vitrine ecru-spot" href="{{ lien }}{{ sep }}modele={{ block.settings.modele }}">
            <span class="ecru-vitrine__image">
              <img
                src="{{ 'ecru-modele-' | append: block.settings.modele | append: '.webp' | asset_url }}"
                alt="Carte ECRU, modèle {{ block.settings.title | escape }}"
                width="1600"
                height="1200"
                loading="lazy"
                decoding="async"
              >
            </span>
            <span class="ecru-vitrine__legende">
              <span class="ecru-vitrine__num" aria-hidden="true">0{{ forloop.index }}</span>
              <span class="ecru-vitrine__titre">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}
                <span class="ecru-vitrine__texte">{{ block.settings.text | escape }}</span>
              {%- endif -%}
              <span class="ecru-vitrine__action">Personnaliser<span class="ecru-mini__fleche" aria-hidden="true"></span></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Modèles ECRU",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Sur mesure" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "À votre image." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Partez d'un modèle, changez le texte, la couleur, ajoutez votre logo. Vous la voyez en 3D avant de commander." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Composer ma carte" },
    { "type": "url", "id": "button_link", "label": "Lien (page produit, variante sur mesure)" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "modele",
      "name": "Modèle",
      "settings": [
        {
          "type": "select",
          "id": "modele",
          "label": "Modèle",
          "options": [
            { "value": "editorial", "label": "Éditorial" },
            { "value": "minimal", "label": "Minimal" },
            { "value": "monogramme", "label": "Monogramme" },
            { "value": "signature", "label": "Signature" },
            { "value": "numero", "label": "Numéro" },
            { "value": "pierre", "label": "Pierre" }
          ],
          "default": "editorial"
        },
        { "type": "text", "id": "title", "label": "Nom", "default": "Éditorial" },
        { "type": "text", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modèles ECRU",
      "blocks": [
        { "type": "modele", "settings": { "modele": "editorial", "title": "Éditorial", "text": "Noir et crème. Votre nom en grand." } },
        { "type": "modele", "settings": { "modele": "monogramme", "title": "Monogramme", "text": "Ton sur ton. Une initiale qui déborde." } },
        { "type": "modele", "settings": { "modele": "minimal", "title": "Minimal", "text": "Crème et noir. Presque rien." } },
        { "type": "modele", "settings": { "modele": "numero", "title": "Numéro", "text": "Graphite. Un chiffre, une adresse." } },
        { "type": "modele", "settings": { "modele": "signature", "title": "Signature", "text": "Écru. Centré, calme." } },
        { "type": "modele", "settings": { "modele": "pierre", "title": "Pierre", "text": "Gris chaud. Typographie de maison." } }
      ]
    }
  ]
}
{% endschema %}
