{%- comment -%}
  ECRU — Données commerciales : études citées avec leur source, et un simulateur
  qui calcule le chiffre d'affaires supplémentaire à partir des chiffres du commerçant.
  Aucune promesse : le calcul est affiché tel quel (clients × panier × taux de retour).
{%- endcomment -%}
<section
  class="ecru-section ecru-croissance"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
  data-ecru-simulateur
>
  <div class="ecru-conteneur">
    <header class="ecru-entete">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="titre-{{ section.id }}" class="ecru-titre ecru-reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="ecru-texte ecru-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="ecru-etudes" role="list">
        {%- for block in section.blocks -%}
          <li class="ecru-etude ecru-spot ecru-reveal" style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <p class="ecru-etude__chiffre">{{ block.settings.chiffre | escape }}</p>
            <p class="ecru-etude__texte">{{ block.settings.texte | escape }}</p>
            {%- if block.settings.source != blank -%}
              <p class="ecru-etude__source">Source : {{ block.settings.source | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="ecru-simu ecru-reveal">
      <div class="ecru-simu__reglages">
        <p class="ecru-simu__titre">Votre commerce</p>
        {%- liquid
          assign champs = 'clients:Clients par mois:20:3000:10:600:|panier:Panier moyen:5:200:1:22: €|retour:Clients qui reviennent aujourd’hui:0:80:1:25: %|gain:Clients fidélisés en plus:1:20:1:5: points'
          assign champs = champs | split: '|'
        -%}
        {%- for c in champs -%}
          {%- assign cc = c | split: ':' -%}
          <div class="ecru-simu__champ">
            <label for="{{ section.id }}-{{ cc[0] }}">
              <span>{{ cc[1] }}</span>
              <output for="{{ section.id }}-{{ cc[0] }}" data-ecru-sortie="{{ cc[0] }}">{{ cc[5] }}{{ cc[6] }}</output>
            </label>
            <input
              id="{{ section.id }}-{{ cc[0] }}"
              type="range"
              min="{{ cc[2] }}"
              max="{{ cc[3] }}"
              step="{{ cc[4] }}"
              value="{{ cc[5] }}"
              data-ecru-simu="{{ cc[0] }}"
              data-unite="{{ cc[6] }}"
            >
          </div>
        {%- endfor -%}
      </div>

      <div class="ecru-simu__resultat">
        <p class="ecru-simu__titre">Chiffre d’affaires en plus, sur 12 mois</p>
        <p class="ecru-simu__gain"><span data-ecru-gain>—</span></p>
        <p class="ecru-simu__detail" data-ecru-detail></p>
        <figure class="ecru-simu__graphique">
          <svg viewBox="0 0 600 240" role="img" aria-labelledby="{{ section.id }}-graph" data-ecru-graphique></svg>
          <figcaption id="{{ section.id }}-graph" class="ecru-simu__legende">
            <span><i class="ecru-simu__puce"></i>Chiffre d’affaires en plus, cumulé mois après mois</span>
          </figcaption>
        </figure>
        <p class="ecru-simu__note">{{ section.settings.note | escape }}</p>
        {%- if section.settings.button_label != blank -%}
          <a class="ecru-bouton" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'ecru-simulateur.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Croissance ECRU",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Les chiffres" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un client qui revient vaut plus." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Ce que disent les études, et ce que cela donnerait chez vous." },
    { "type": "text", "id": "note", "label": "Note sous le graphique", "default": "Simulation indicative, calculée avec vos chiffres : clients × panier moyen × part de clients qui reviennent, avec une montée progressive sur 4 mois. Ce n’est pas une promesse de résultat." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Lancer ma fidélité" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "etude",
      "name": "Étude",
      "settings": [
        { "type": "paragraph", "content": "Uniquement des chiffres publiés, avec leur source." },
        { "type": "text", "id": "chiffre", "label": "Chiffre", "default": "+25 à 95 %" },
        { "type": "text", "id": "texte", "label": "Texte", "default": "de bénéfices quand la fidélisation des clients augmente de 5 %." },
        { "type": "text", "id": "source", "label": "Source", "default": "Frederick F. Reichheld, Bain & Company" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Croissance ECRU",
      "blocks": [
        { "type": "etude", "settings": { "chiffre": "+25 à 95 %", "texte": "de bénéfices quand la fidélisation des clients augmente de 5 %.", "source": "Frederick F. Reichheld, Bain & Company" } },
        { "type": "etude", "settings": { "chiffre": "60 à 70 %", "texte": "de chances de vendre à un client déjà venu, contre 5 à 20 % pour un nouveau.", "source": "Farris, Bendle, Pfeifer, Reibstein, « Marketing Metrics »" } }
      ]
    }
  ]
}
{% endschema %}
