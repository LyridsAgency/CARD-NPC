{%- comment -%}
  ECRU — Formulaire « Demande particulière » (envoyé par le formulaire de contact Shopify).
  Les champs supplémentaires arrivent dans l'e-mail de contact, avec leur intitulé.
{%- endcomment -%}
<section
  class="ecru-section ecru-demande"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
>
  <div class="ecru-conteneur ecru-demande__grille">
    <header class="ecru-entete">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ecru-surtitre">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="titre-{{ section.id }}" class="ecru-titre ecru-titre--m">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="ecru-texte">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- assign points = section.settings.points | newline_to_br | split: '<br />' -%}
      {%- if section.settings.points != blank -%}
        <ul class="ecru-offre__liste" role="list">
          {%- for p in points -%}
            {%- assign pp = p | strip -%}
            {%- if pp != blank -%}<li>{{ pp | escape }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    {%- form 'contact', id: 'ecru-demande-form', class: 'ecru-demande__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="ecru-demande__message" role="status" tabindex="-1" autofocus>
          <p class="ecru-titre ecru-titre--s">Merci.</p>
          <p class="ecru-texte">{{ section.settings.success | escape }}</p>
        </div>
      {%- elsif form.errors -%}
        <div class="ecru-demande__message ecru-demande__message--erreur" role="alert" tabindex="-1" autofocus>
          <p class="ecru-texte">Vérifiez les champs signalés :</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Type de message]" value="Demande de devis">
      <input type="hidden" name="contact[Produit]" value="" data-ecru-produit-source>
      <input type="hidden" name="contact[Estimation affichée]" value="" data-ecru-estimation-champ>

      {%- liquid
        assign simple = all_products['cartes-simples']
        assign mesure = all_products['cartes-sur-mesure']
        assign lien = all_products['option-lien']
        assign abo = all_products['abonnement-fidelite']
        assign quantites = '10|50|100|250|500|1000' | split: '|'
      -%}
      <fieldset class="ecru-option ecru-devis__groupe">
        <legend><span class="ecru-option__etape" aria-hidden="true">01</span>La carte</legend>
        <div class="ecru-option__choix">
          <input type="radio" id="devis-type-1" name="contact[Carte]" value="Vierge (noire ou blanche)" data-ecru-devis="type" data-cle="simple">
          <label for="devis-type-1">Vierge</label>
          <input type="radio" id="devis-type-2" name="contact[Carte]" value="Sur mesure" data-ecru-devis="type" data-cle="mesure" checked>
          <label for="devis-type-2">Sur mesure</label>
        </div>
        <p class="ecru-champ__aide" data-ecru-devis-aide="type"></p>
      </fieldset>

      <fieldset class="ecru-option ecru-devis__groupe">
        <legend><span class="ecru-option__etape" aria-hidden="true">02</span>Matière</legend>
        <div class="ecru-option__choix">
          {%- assign matieres = 'PVC|Métal' | split: '|' -%}
          {%- for m in matieres -%}
            <input type="radio" id="devis-mat-{{ forloop.index }}" name="contact[Matière]" value="{{ m }}" data-ecru-devis="matiere" {% if forloop.first %}checked{% endif %}>
            <label for="devis-mat-{{ forloop.index }}">{{ m }}</label>
          {%- endfor -%}
        </div>
      </fieldset>

      <fieldset class="ecru-option ecru-devis__groupe">
        <legend><span class="ecru-option__etape" aria-hidden="true">03</span>Liens sur la puce</legend>
        <div class="ecru-option__choix">
          {%- for n in (0..4) -%}
            <input type="radio" id="devis-liens-{{ n }}" name="contact[Liens]" value="{{ n }}" data-ecru-devis="liens" {% if n == 1 %}checked{% endif %}>
            <label for="devis-liens-{{ n }}">{% if n == 0 %}Aucun{% else %}{{ n }}{% endif %}</label>
          {%- endfor -%}
        </div>
        <p class="ecru-champ__aide">Menu, avis Google, Instagram, site… {% if lien != blank %}+ {{ lien.price | money_without_currency | replace: '.', ' ' | append: ' €' }} par carte et par lien.{% endif %}</p>
      </fieldset>

      <fieldset class="ecru-option ecru-devis__groupe" data-ecru-devis-fidelite>
        <legend><span class="ecru-option__etape" aria-hidden="true">04</span>Option</legend>
        <label class="ecru-interrupteur">
          <input type="checkbox" name="contact[Option fidélité]" value="Oui" data-ecru-devis="fidelite">
          <span class="ecru-interrupteur__piste" aria-hidden="true"></span>
          <span class="ecru-interrupteur__texte">
            <strong>Programme de fidélité</strong>
            <span data-ecru-devis-aide="fidelite">Tampons ou points, vos propres récompenses.</span>
          </span>
          {%- if abo != blank -%}<span class="ecru-interrupteur__prix">+ {{ abo.price | money_without_currency | replace: '.', ' ' | append: ' €' }} / mois</span>{%- endif -%}
        </label>
      </fieldset>

      <fieldset class="ecru-option ecru-devis__groupe">
        <legend><span class="ecru-option__etape" aria-hidden="true">05</span>Quantité</legend>
        <div class="ecru-option__choix">
          {%- for q in quantites -%}
            <input type="radio" id="devis-q-{{ q }}" name="contact[Quantité]" value="{% if forloop.last %}1000 et plus{% else %}{{ q }}{% endif %}" data-ecru-devis="quantite" data-q="{{ q }}" {% if q == '100' %}checked{% endif %}>
            <label for="devis-q-{{ q }}">{% if forloop.last %}1 000 +{% else %}{{ q }}{% endif %}</label>
          {%- endfor -%}
        </div>
      </fieldset>

      <div class="ecru-devis__estimation" aria-live="polite">
        <p class="ecru-devis__label">Estimation</p>
        <p class="ecru-devis__montant" data-ecru-estimation>—</p>
        <dl class="ecru-devis__detail" data-ecru-estimation-detail></dl>
      </div>

      <fieldset class="ecru-option ecru-devis__groupe">
        <legend><span class="ecru-option__etape" aria-hidden="true">06</span>Vos coordonnées</legend>
        <div class="ecru-demande__ligne">
          <div class="ecru-champ">
            <label for="demande-nom">Nom <span aria-hidden="true">*</span></label>
            <input id="demande-nom" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
          </div>
          <div class="ecru-champ">
            <label for="demande-email">E-mail <span aria-hidden="true">*</span></label>
            <input id="demande-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
          </div>
        </div>
        <div class="ecru-demande__ligne">
          <div class="ecru-champ">
            <label for="demande-commerce">Commerce</label>
            <input id="demande-commerce" type="text" name="contact[Commerce]" autocomplete="organization">
          </div>
          <div class="ecru-champ">
            <label for="demande-tel">Téléphone</label>
            <input id="demande-tel" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
        </div>
        <div class="ecru-champ">
          <label for="demande-message">Un détail à ajouter ?</label>
          <textarea id="demande-message" name="contact[body]" rows="3" placeholder="Couleurs, délai, événement…">{{ form.body }}</textarea>
        </div>
      </fieldset>
      <p class="ecru-champ__aide">* Obligatoire. Réponse par e-mail avec un devis précis. Votre logo pourra être envoyé en réponse.</p>
      <div class="ecru-actions">
        <button type="submit" class="ecru-bouton">{{ section.settings.button_label | escape }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{%- comment -%} Prix en centimes, lus dans la boutique : modifier un prix dans Shopify met le devis à jour {%- endcomment -%}
<script type="application/json" id="ecru-devis-prix">
  {
    "simple": {
      {%- for v in simple.variants -%}{{ v.option1 | json }}: {{ v.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
    },
    "mesure": {
      {%- for v in mesure.variants -%}{{ v.option1 | json }}: {{ v.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
    },
    "moq": { "simple": 10, "mesure": 100 },
    "lien": {{ lien.price | default: 0 }},
    "mois": {{ abo.price | default: 0 }}
  }
</script>
<script>
  (function () {
    var form = document.getElementById('ecru-demande-form');
    if (!form) return;
    var prix = {};
    try { prix = JSON.parse(document.getElementById('ecru-devis-prix').textContent); } catch (e) {}
    var devise = {{ cart.currency.iso_code | json }};
    var argent = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: devise, maximumFractionDigits: 0 });
    var argentPrecis = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: devise });
    var montant = form.querySelector('[data-ecru-estimation]');
    var detail = form.querySelector('[data-ecru-estimation-detail]');
    var champ = form.querySelector('[data-ecru-estimation-champ]');
    var caseFid = form.querySelector('[data-ecru-devis="fidelite"]');
    var aideFid = form.querySelector('[data-ecru-devis-aide="fidelite"]');
    var aideType = form.querySelector('[data-ecru-devis-aide="type"]');
    function choisi(nom) {
      return form.querySelector('[data-ecru-devis="' + nom + '"]:checked');
    }
    function ligne(dt, dd) {
      return '<div><dt>' + dt + '</dt><dd>' + dd + '</dd></div>';
    }
    function maj() {
      var cle = choisi('type').dataset.cle;
      var matiere = choisi('matiere').value;
      var liens = parseInt(choisi('liens').value, 10) || 0;
      var moq = prix.moq[cle];
      // Quantités sous le minimum : grisées
      form.querySelectorAll('[data-ecru-devis="quantite"]').forEach(function (r) {
        r.disabled = parseInt(r.dataset.q, 10) < moq;
      });
      if (choisi('quantite') === null || choisi('quantite').disabled) {
        form.querySelector('[data-ecru-devis="quantite"][data-q="' + moq + '"]').checked = true;
      }
      var q = parseInt(choisi('quantite').dataset.q, 10);
      // La fidélité s'ajoute au sur mesure
      caseFid.disabled = cle !== 'mesure';
      if (caseFid.disabled) caseFid.checked = false;
      aideFid.textContent = caseFid.disabled ? 'Disponible avec les cartes sur mesure.' : 'Tampons ou points, vos propres récompenses. Le client scanne, vous validez.';
      aideType.textContent = cle === 'mesure' ? 'Votre couleur, votre texte, votre logo. Dès ' + moq + ' cartes.' : 'Noire ou blanche, sans marquage. Dès ' + moq + ' cartes.';

      var unite = (prix[cle] && (prix[cle][matiere] || Object.values(prix[cle])[0])) || 0;
      var html = ligne(q + ' cartes ' + matiere + ' × ' + argentPrecis.format(unite / 100), argent.format((q * unite) / 100));
      var total = q * unite;
      if (liens) {
        html += ligne(liens + (liens > 1 ? ' liens' : ' lien') + ' × ' + q + ' cartes × ' + argentPrecis.format(prix.lien / 100), argent.format((q * liens * prix.lien) / 100));
        total += q * liens * prix.lien;
      }
      var texte;
      if (q >= 1000) {
        texte = 'Sur devis';
        html += ligne('Au-delà de 1 000 cartes', 'prix dégressif');
      } else {
        texte = argent.format(total / 100);
        html += ligne('Livraison', 'en sus');
      }
      if (caseFid.checked) html += ligne('Option fidélité', argentPrecis.format(prix.mois / 100) + ' / mois');
      montant.textContent = texte;
      detail.innerHTML = html;
      champ.value = texte + ' — ' + detail.innerText.replace(/\n+/g, ' · ');
    }
    form.addEventListener('change', maj);
    var produit = new URLSearchParams(window.location.search).get('produit');
    var source = form.querySelector('[data-ecru-produit-source]');
    if (produit && source) source.value = produit;
    if (produit) {
      var fid = /fid/i.test(produit);
      var r = form.querySelector('[data-ecru-devis="type"][data-cle="' + (/simple/i.test(produit) ? 'simple' : 'mesure') + '"]');
      if (r) r.checked = true;
      if (fid) caseFid.checked = true;
    }
    maj();
  })();
</script>

{% schema %}
{
  "name": "Demande particulière ECRU",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Sur mesure" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Votre devis." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Cinq choix, le prix tout de suite, un devis précis par e-mail." },
    { "type": "textarea", "id": "points", "label": "Exemples (un par ligne)", "default": "Festivals et soirées\nGrandes quantités\nCouleurs et designs sur mesure\nFinitions spéciales" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Recevoir mon devis" },
    { "type": "text", "id": "success", "label": "Message après envoi", "default": "Votre demande est bien partie. Nous revenons vers vous par e-mail." },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 128 }
  ],
  "presets": [{ "name": "Demande particulière ECRU" }]
}
{% endschema %}
