{%- comment -%}
  ECRU — Page produit en configurateur : la carte 3D à la place de la photo.
  - Matière : PVC (mat) ou Métal (satiné).
  - Modèle : Noir et Blanc (cartes vierges), Sur mesure (éditeur : couleur, nom et logo placés librement).
  - MOQ par option (Paramètres du thème → ECRU). Le plus grand minimum des options choisies s'applique.
  - Tous les choix partent avec la commande (propriétés de ligne).
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign uid = 'ecru-produit-' | append: section.id
  assign contact = settings.ecru_contact_link | default: '/pages/demande-particuliere'
  assign moq_texte = settings.ecru_moq_texte | default: '[À définir]'
  assign lignes_moq = settings.ecru_moq | newline_to_br | split: '<br />'
  assign lignes_couleurs = settings.ecru_couleurs | newline_to_br | split: '<br />'

  assign finish = 'metal'
  assign color = '#0d0d0c'
  for value in current.options
    assign v = value | downcase | strip
    if v contains 'pvc'
      assign finish = 'mat'
    endif
    for l in lignes_couleurs
      assign parts = l | split: ':'
      assign k = parts[0] | strip | downcase
      if k == v and parts[1] != blank
        assign color = parts[1] | strip
      endif
    endfor
  endfor
  assign est_sur_mesure = false
  if product.tags contains 'sur-mesure'
    assign est_sur_mesure = true
  endif
  assign est_fidelite = false
  if product.tags contains 'fidelite'
    assign est_fidelite = true
  endif
  comment
    MOQ propre au produit : ligne « Fidélité: 100 » (accents ignorés) pour les produits taggés fidelite
  endcomment
  assign moq_produit = 0
  for l in lignes_moq
    assign k = l | split: ':' | first | strip | downcase | replace: 'é', 'e' | replace: ' ', '-'
    if k != blank and product.tags contains k
      assign moq_produit = l | split: ':' | last | strip | plus: 0
    endif
  endfor
  assign ink = '#e9e4d8'
  assign c = color | color_brightness
  if c > 150
    assign ink = '#121211'
  endif

  assign palette = 'Noir:#0d0d0c|Graphite:#2a2926|Pierre:#8f8a80|Écru:#d6cfbf|Crème:#e9e4d8|Bordeaux:#5a1a22|Vert anglais:#1f3a2e|Bleu nuit:#1b2440' | split: '|'
  assign palette_marquage = 'Crème:#e9e4d8|Noir:#121211|Ton sur ton:#7d7b76|Or:#c2a165|Argent:#c9c8c4' | split: '|'
  assign palette_fenetre = 'Ton sur ton:auto|Noir:#121211|Graphite:#3a3936|Crème:#e9e4d8|Or:#b8975a|Argent:#c9c8c4|Bordeaux:#5a1a22|Bleu nuit:#1b2440' | split: '|'
  assign modeles = 'editorial:Éditorial|minimal:Minimal|monogramme:Monogramme|signature:Signature|numero:Numéro|pierre:Pierre' | split: '|'
-%}

<section
  class="ecru-section ecru-produit"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  data-ecru-produit
>
  <div class="ecru-conteneur ecru-produit__grille">
    <div class="ecru-produit__visuel">
      {%- render 'ecru-carte', id: uid, color: color, ink: ink, finish: finish, alt: product.title, compact: true -%}
      <div class="ecru-produit__sous-carte">
        <p class="ecru-produit__mention">
          <span data-ecru-legende>{{ current.options | join: ' · ' }}</span> · Glissez pour tourner
        </p>
        <button type="button" class="ecru-retourner" data-ecru-retourner aria-pressed="false">
          <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M4 8a6 6 0 0 1 11-2l1 1M16 12a6 6 0 0 1-11 2l-1-1M16 3v4h-4M4 17v-4h4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
          Retourner
        </button>
      </div>
    </div>

    <div class="ecru-produit__infos">
      {%- if product.type != blank -%}
        <p class="ecru-surtitre">{{ product.type | escape }}</p>
      {%- endif -%}
      <h1 class="ecru-titre">{{ product.title | escape }}</h1>
      <p class="ecru-produit__format">Format carte bancaire · 85,6 × 54 mm</p>

      <div class="ecru-produit__prix">
        {%- render 'price', product: product, use_variant: true -%}
        {%- unless settings.ecru_prix_a_definir -%}
          <span class="ecru-produit__unite">la carte</span>
        {%- endunless -%}
      </div>

      {%- form 'product', product, id: 'form-produit', class: 'ecru-produit__form', novalidate: 'novalidate', data-ecru-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-ecru-variant>

        {%- assign etape = 0 -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign etape = etape | plus: 1
              assign nom_option = option.name | downcase
              assign est_couleur = false
              if nom_option contains 'couleur' or nom_option contains 'color' or nom_option contains 'modèle' or nom_option contains 'modele'
                assign est_couleur = true
              endif
              assign est_matiere = false
              if nom_option contains 'mati'
                assign est_matiere = true
              endif
            -%}
            <fieldset class="ecru-option{% if est_couleur %} ecru-option--couleur{% endif %}{% if est_matiere %} ecru-option--matiere{% endif %}">
              <legend>
                <span class="ecru-option__etape" aria-hidden="true">0{{ etape }}</span>
                {{ option.name | escape }}
                {%- if est_couleur -%}
                  <span class="ecru-option__valeur" data-ecru-valeur="{{ option.position }}">{{ option.selected_value | escape }}</span>
                {%- endif -%}
              </legend>
              <div class="ecru-option__choix">
                {%- for value in option.values -%}
                  {%- liquid
                    assign oid = uid | append: '-' | append: option.position | append: '-' | append: forloop.index
                    assign vb = value | downcase | strip
                    assign teinte = ''
                    for l in lignes_couleurs
                      assign parts = l | split: ':'
                      assign k = parts[0] | strip | downcase
                      if k == vb
                        assign teinte = parts[1] | strip
                      endif
                    endfor
                    assign genre = 'teinte'
                    if vb contains 'design' or vb contains 'mesure' or vb contains 'custom' or vb contains 'personnal'
                      assign genre = 'design'
                    endif
                  -%}
                  <input
                    type="radio"
                    id="{{ oid }}"
                    name="option{{ option.position }}"
                    value="{{ value | escape }}"
                    data-position="{{ option.position }}"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >
                  {%- if est_couleur -%}
                    <label for="{{ oid }}" class="ecru-pastille ecru-pastille--{{ genre }}" title="{{ value | escape }}">
                      <span class="ecru-pastille__teinte" style="--teinte: {{ teinte | default: '#2a2926' }}" aria-hidden="true">
                        {%- if genre == 'design' -%}
                          <svg viewBox="0 0 20 20" width="16" height="16"><path d="M4 16l1-4 8-8 3 3-8 8-4 1z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
                        {%- endif -%}
                      </span>
                      <span class="ecru-pastille__nom">{{ value | escape }}</span>
                    </label>
                  {%- elsif est_matiere -%}
                    <label for="{{ oid }}" class="ecru-matiere-choix">
                      <span class="ecru-matiere-choix__nom">{{ value | escape }}</span>
                    </label>
                  {%- else -%}
                    <label for="{{ oid }}">{{ value | escape }}</label>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if est_couleur -%}
                <p class="ecru-perso__note" data-ecru-note="standard">Carte vierge, sans écriture.</p>

              {%- endif -%}

              {%- if forloop.last and est_fidelite == false and est_sur_mesure == false -%}
                <p class="ecru-option__aide">
                  Minimum de commande :
                  <strong data-ecru-moq>{{ moq_texte | escape }}</strong>
                </p>
              {%- endif -%}
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        {%- if est_sur_mesure -%}
          {%- assign etape = etape | plus: 1 -%}
          <fieldset class="ecru-option ecru-option--design">
            <legend>
              <span class="ecru-option__etape" aria-hidden="true">0{{ etape }}</span>
              Votre design
            </legend>
                {%- comment -%} Sur mesure : éditeur intégré {%- endcomment -%}
                <div class="ecru-panneau ecru-createur" data-ecru-panneau="design">
                  <div class="ecru-faces" role="group" aria-label="Face à composer">
                    <button type="button" class="ecru-faces__btn" data-ecru-face="recto" aria-pressed="true">Recto</button>
                    <button type="button" class="ecru-faces__btn" data-ecru-face="verso" aria-pressed="false">Verso</button>
                  </div>
                  <div class="ecru-editeur" data-ecru-editeur aria-label="Carte à composer" role="group">
                    <div class="ecru-editeur__symbole" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 7a7 7 0 0 1 0 10M11.5 4.5a11 11 0 0 1 0 15M4.5 9.5a3.5 3.5 0 0 1 0 5"/></svg></div>
                    <div class="ecru-editeur__nfc" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 7a7 7 0 0 1 0 10M11.5 4.5a11 11 0 0 1 0 15M4.5 9.5a3.5 3.5 0 0 1 0 5"/></svg></div>
                    <div class="ecru-editeur__guide ecru-editeur__guide--v" aria-hidden="true"></div>
                    <div class="ecru-editeur__guide ecru-editeur__guide--h" aria-hidden="true"></div>
                  </div>
                  <p class="ecru-champ__aide">Partez d'un modèle, touchez un texte pour le modifier, glissez-le où vous voulez. Faites tourner la carte 3D du doigt.</p>

                  <div class="ecru-createur__ligne ecru-createur__ligne--modeles">
                    <span class="ecru-createur__label">Modèles</span>
                    <div class="ecru-modeles" role="group" aria-label="Modèles prêts à personnaliser">
                      {%- for m in modeles -%}
                        {%- assign mm = m | split: ':' -%}
                        <button type="button" class="ecru-modele" data-ecru-modele="{{ mm[0] }}" aria-pressed="false" title="{{ mm[1] }}">
                          <img src="{{ 'ecru-modele-' | append: mm[0] | append: '.webp' | asset_url }}" alt="" width="160" height="120" loading="lazy" decoding="async">
                          <span class="visually-hidden">Modèle {{ mm[1] }}</span>
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                  <div class="ecru-createur__ligne">
                    <span class="ecru-createur__label">Couleur</span>
                    {%- render 'ecru-palette', cible: 'fond', teintes: palette, libre: '#1b2440', label: 'Couleur de la carte' -%}
                  </div>
                  <div class="ecru-createur__ligne">
                    <span class="ecru-createur__label">Marquage</span>
                    {%- render 'ecru-palette', cible: 'relief', teintes: palette_marquage, libre: '#c2a165', label: 'Couleur du nom et du logo' -%}
                  </div>
                  <div class="ecru-createur__ligne">
                    <span class="ecru-createur__label">Fenêtre</span>
                    {%- render 'ecru-palette', cible: 'fenetre', teintes: palette_fenetre, libre: '#3a3936', label: 'Couleur de la fenêtre NFC' -%}
                  </div>
                  <div class="ecru-createur__ligne">
                    <label class="ecru-createur__label" for="{{ uid }}-nom">Texte</label>
                    <input id="{{ uid }}-nom" class="ecru-createur__nom" type="text" name="properties[Nom]" maxlength="32" value="Votre marque" placeholder="Votre marque" autocomplete="off" data-ecru-nom>
                  </div>
                  <div class="ecru-createur__ligne">
                    <span class="ecru-createur__label">Logo</span>
                    <input
                      id="{{ uid }}-logo"
                      class="ecru-outil__fichier"
                      type="file"
                      name="properties[Logo]"
                      accept="image/png,image/jpeg,image/svg+xml"
                      data-ecru-fichier
                    >
                    <label for="{{ uid }}-logo" class="ecru-outil">Ajouter</label>
                    <span class="ecru-fichier__nom" data-ecru-fichier-nom></span>
                    <button type="button" class="ecru-outil ecru-outil--discret" data-ecru-logo-retirer hidden>Retirer</button>
                  </div>
                  <div class="ecru-createur__ligne" data-ecru-reglages hidden>
                    <label class="ecru-createur__label" for="{{ uid }}-taille">Taille</label>
                    <input id="{{ uid }}-taille" class="ecru-createur__taille" type="range" min="4" max="40" step="1" value="12" data-ecru-el-taille>
                  </div>

                  <input type="hidden" name="properties[Couleur]" value="#0d0d0c" data-ecru-champ="fond">
              <input type="hidden" name="properties[Fenêtre NFC]" value="" data-ecru-champ="fenetre">
                  <input type="hidden" name="properties[Fenêtre NFC]" value="" data-ecru-champ="fenetre">
                  <input type="hidden" name="properties[Marquage]" value="#e9e4d8" data-ecru-champ="relief">
                  <input type="hidden" name="properties[Maquette]" value="" data-ecru-maquette>
                  <input type="hidden" name="properties[_maquette]" value="" data-ecru-maquette-json>
                </div>
            <p class="ecru-option__aide">
              Minimum de commande :
              <strong data-ecru-moq>{{ moq_texte | escape }}</strong>
            </p>
          </fieldset>
        {%- endif -%}

        {%- if est_fidelite -%}
          {%- assign etape = etape | plus: 1 -%}
          <fieldset class="ecru-option ecru-option--fidelite">
            <legend>
              <span class="ecru-option__etape" aria-hidden="true">0{{ etape }}</span>
              Votre carte
            </legend>
            <p class="ecru-perso__note">La même base élégante pour tous : vous choisissez la couleur, nous y posons votre logo.</p>
            <div class="ecru-panneau ecru-createur" data-ecru-panneau="fidelite">
              <div class="ecru-editeur is-fixe" data-ecru-editeur aria-label="Aperçu de votre carte de fidélité" role="img">
                <div class="ecru-editeur__symbole" aria-hidden="true"></div>
                <div class="ecru-editeur__nfc" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 7a7 7 0 0 1 0 10M11.5 4.5a11 11 0 0 1 0 15M4.5 9.5a3.5 3.5 0 0 1 0 5"/></svg></div>
              </div>
              <p class="ecru-champ__aide">Le logo ECRU s’affiche en attendant le vôtre.</p>
              <div class="ecru-createur__ligne ecru-createur__ligne--modeles">
                <span class="ecru-createur__label">Suggestions</span>
                <div class="ecru-assortiments" role="group" aria-label="Jeux de couleurs suggérés">
                  {%- assign jeux = 'Noir et graphite:#0d0d0c:#3a3936|Noir et or:#0d0d0c:#b8975a|Crème et noir:#e9e4d8:#121211|Bordeaux et or:#5a1a22:#b8975a|Vert anglais et crème:#1f3a2e:#e9e4d8|Bleu nuit et argent:#1b2440:#c9c8c4' | split: '|' -%}
                  {%- for j in jeux -%}
                    {%- assign jj = j | split: ':' -%}
                    <button type="button" class="ecru-assortiment" data-fond="{{ jj[1] }}" data-fenetre="{{ jj[2] }}" aria-pressed="false" title="{{ jj[0] }}" style="--fond: {{ jj[1] }}; --fenetre: {{ jj[2] }}; --marquage: {{ jj[2] }}">
                      <span class="ecru-assortiment__carte ecru-assortiment__carte--fenetre" aria-hidden="true"><i></i></span>
                      <span class="visually-hidden">{{ jj[0] }}</span>
                    </button>
                  {%- endfor -%}
                </div>
              </div>
              <div class="ecru-createur__ligne">
                <span class="ecru-createur__label">Couleur</span>
                {%- render 'ecru-palette', cible: 'fond', teintes: palette, libre: '#1b2440', label: 'Couleur de la carte' -%}
              </div>
              <div class="ecru-createur__ligne">
                <span class="ecru-createur__label">Fenêtre</span>
                {%- render 'ecru-palette', cible: 'fenetre', teintes: palette_fenetre, libre: '#3a3936', label: 'Couleur de la fenêtre NFC' -%}
              </div>
              <div class="ecru-createur__ligne">
                <span class="ecru-createur__label">Logo *</span>
                <input
                  id="{{ uid }}-logo"
                  class="ecru-outil__fichier"
                  type="file"
                  name="properties[Logo]"
                  accept="image/png,image/jpeg,image/svg+xml"
                  required
                  aria-required="true"
                  data-ecru-fichier
                >
                <label for="{{ uid }}-logo" class="ecru-outil">Ajouter</label>
                <span class="ecru-fichier__nom" data-ecru-fichier-nom></span>
                <button type="button" class="ecru-outil ecru-outil--discret" data-ecru-logo-retirer hidden>Retirer</button>
              </div>
              <p class="ecru-champ__aide">Obligatoire pour commander. PNG ou SVG sur fond transparent de préférence.</p>
              <input type="hidden" name="properties[Couleur]" value="#0d0d0c" data-ecru-champ="fond">
              <input type="hidden" name="properties[Fenêtre NFC]" value="" data-ecru-champ="fenetre">
              <input type="hidden" name="properties[Maquette]" value="" data-ecru-maquette>
              <input type="hidden" name="properties[_maquette]" value="" data-ecru-maquette-json>
            </div>
            <details class="ecru-page-infos">
              <summary>Votre page (ouverte par la carte)</summary>
              <p class="ecru-champ__aide">Vous pourrez la compléter ou la modifier plus tard en nous écrivant.</p>
              <div class="ecru-champ">
                <label for="{{ uid }}-recompense">Récompense</label>
                <input id="{{ uid }}-recompense" type="text" name="properties[Récompense]" maxlength="80" placeholder="10 visites : le dessert offert">
              </div>
              {%- assign liens = 'Menu:https://…/menu|Avis:https://g.page/…|Réseaux:https://instagram.com/…|Site:https://votre-site.fr' | split: '|' -%}
              {%- for l in liens -%}
                {%- assign ll = l | split: ':' -%}
                <div class="ecru-champ">
                  <label for="{{ uid }}-lien-{{ forloop.index }}">Lien : {{ ll[0] | downcase }}</label>
                  <input id="{{ uid }}-lien-{{ forloop.index }}" type="url" inputmode="url" name="properties[Lien {{ ll[0] | downcase }}]" placeholder="{{ l | remove_first: ll[0] | remove_first: ':' }}">
                </div>
              {%- endfor -%}
            </details>
            {%- if section.settings.abonnement != blank -%}
              {%- assign abo = section.settings.abonnement -%}
              <p class="ecru-abonnement">
                <span>Programme de fidélité</span>
                <strong>{{ abo.price | money }} / mois</strong>
              </p>
            {%- endif -%}
            <p class="ecru-option__aide">
              Minimum de commande :
              <strong data-ecru-moq>{{ moq_texte | escape }}</strong>
            </p>
          </fieldset>
        {%- endif -%}

        {%- if section.settings.show_perso and est_fidelite == false -%}
          {%- assign etape = etape | plus: 1 -%}
          <fieldset class="ecru-option ecru-perso" data-ecru-liens>
            <legend>
              <span class="ecru-option__etape" aria-hidden="true">0{{ etape }}</span>
              Liens
            </legend>
            <div class="ecru-champ">
              <label for="{{ uid }}-lien">Lien principal</label>
              <input id="{{ uid }}-lien" type="url" name="properties[Lien]" placeholder="https://votre-site.fr" inputmode="url">
            </div>
            {%- for i in (2..4) -%}
              <div class="ecru-champ" data-ecru-lien-sup hidden>
                <label for="{{ uid }}-lien-{{ i }}">Lien {{ i }}</label>
                <input id="{{ uid }}-lien-{{ i }}" type="url" name="properties[Lien {{ i }}]" placeholder="Menu, avis, Instagram…" inputmode="url" disabled>
              </div>
            {%- endfor -%}
            <button type="button" class="ecru-outil" data-ecru-lien-ajout>+ Ajouter un lien</button>
            <p class="ecru-champ__aide">Un seul lien : la carte l’ouvre directement. Plusieurs : elle ouvre une page à vos couleurs qui les réunit. Modifiable plus tard sur simple demande.</p>
          </fieldset>
        {%- endif -%}

        {%- comment -%} Blocs d'applications (ex. choix d'abonnement de Shopify Subscriptions) {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="ecru-produit__app">{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}

        <div class="ecru-produit__achat">
          <div class="ecru-produit__quantite">
            <button type="button" data-ecru-qte="-1" aria-label="Retirer une carte">−</button>
            <label class="visually-hidden" for="{{ uid }}-qte">Quantité</label>
            <input id="{{ uid }}-qte" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-ecru-quantite>
            <button type="button" data-ecru-qte="1" aria-label="Ajouter une carte">+</button>
          </div>
          <button
            type="submit"
            class="ecru-bouton"
            data-ecru-ajout
            {% unless current.available %}
              disabled
            {% endunless %}
          >
            {%- if current.available -%}
              {{ section.settings.add_label | escape }}
            {%- else -%}
              Indisponible
            {%- endif -%}
          </button>
        </div>
        <a class="ecru-bouton ecru-bouton--ligne ecru-produit__contact" href="{{ contact }}?produit={{ product.title | url_encode }}">
          {{- section.settings.contact_label | escape -}}
        </a>
        {%- unless settings.ecru_prix_a_definir -%}
          <p class="ecru-produit__total" aria-live="polite" data-ecru-total></p>
        {%- endunless -%}
        <p class="ecru-produit__erreur" role="status" aria-live="polite" data-ecru-statut></p>
        <ul class="ecru-produit__rassurance" role="list">
          <li>Aperçu 3D avant de commander</li>
          {%- liquid
            assign moq_min = 0
            for l in lignes_moq
              assign q = l | split: ':' | last | strip | plus: 0
              if q > 0
                if moq_min == 0 or q < moq_min
                  assign moq_min = q
                endif
              endif
            endfor
          -%}
          {%- if moq_min > 0 -%}<li>Dès {{ moq_min }} cartes</li>{%- endif -%}
          <li>Sans application pour vos clients</li>
        </ul>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="ecru-produit__description rte">{{ product.description }}</div>
      {%- endif -%}

      {%- assign details = section.blocks | where: 'type', 'details' -%}
      {%- if details.size > 0 -%}
        <div class="ecru-produit__details ecru-faq">
          {%- for block in details -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title | escape }}</summary>
              <div class="ecru-faq__reponse">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-ecru-donnees>
    {
      "variants": {{ product.variants | json }},
      "moq": {
        {%- assign premier = true -%}
        {%- for l in lignes_moq -%}
          {%- assign parts = l | split: ':' -%}
          {%- assign k = parts[0] | strip | downcase -%}
          {%- if k != blank -%}
            {%- assign q = parts[1] | strip | plus: 0 -%}
            {%- unless premier %},{% endunless -%}
            {{ k | json }}: {{ q }}
            {%- assign premier = false -%}
          {%- endif -%}
        {%- endfor -%}
      },
      "couleurs": {
        {%- assign premier = true -%}
        {%- for l in lignes_couleurs -%}
          {%- assign parts = l | split: ':' -%}
          {%- assign k = parts[0] | strip | downcase -%}
          {%- if k != blank and parts[1] != blank -%}
            {%- unless premier %},{% endunless -%}
            {{ k | json }}: {{ parts[1] | strip | json }}
            {%- assign premier = false -%}
          {%- endif -%}
        {%- endfor -%}
      },
      "moqTexte": {{ moq_texte | json }},
      "moqProduit": {{ moq_produit }},
      "devise": {{ cart.currency.iso_code | json }},
      "fidelite": {{ est_fidelite }},
      "surMesure": {{ est_sur_mesure }},
      {%- if est_fidelite and section.settings.abonnement != blank -%}
        {%- assign abo = section.settings.abonnement -%}
        {%- assign plan = abo.selling_plan_groups.first.selling_plans.first -%}
        "abonnement": { "id": {{ abo.selected_or_first_available_variant.id }}, "plan": {{ plan.id | default: 'null' }} },
      {%- endif -%}
      "ajout": {{ section.settings.add_label | json }}
    }
  </script>
</section>

<script src="{{ 'ecru-configurateur.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Produit ECRU",
  "tag": "div",
  "class": "section-ecru-produit",
  "settings": [
    { "type": "header", "content": "Commande" },
    { "type": "product", "id": "abonnement", "label": "Produit d'abonnement (offre Fidélité)", "info": "Ajouté au panier avec les cartes Fidélité, avec sa formule mensuelle (Shopify Subscriptions)." },
    { "type": "checkbox", "id": "show_perso", "label": "Demander le lien (produits avec le tag « simple »)", "default": true },
    { "type": "text", "id": "add_label", "label": "Ajouter au panier", "default": "Ajouter au panier" },
    { "type": "text", "id": "contact_label", "label": "Demande particulière", "default": "Demande particulière" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "details",
      "name": "Détail repliable",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Comment ça marche" },
        { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Vos clients approchent la carte de leur téléphone. La page s'ouvre. Sans application.</p>" }
      ]
    }
  ]
}
{% endschema %}
