{%- comment -%}
  ECRU — Page produit en configurateur : la carte 3D à la place de la photo.
  - Matière : PVC (mat) ou Métal (satiné).
  - Modèle : Noir et Blanc (cartes vierges), Couleur sur mesure (teinte seule),
    Design sur mesure (éditeur : textes et logo placés librement, couleurs).
  - MOQ par option (Paramètres du thème → ECRU). Le plus grand minimum des options choisies s'applique.
  - Tous les choix partent avec la commande (propriétés de ligne).
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign uid = 'ecru-produit-' | append: section.id
  assign contact = settings.ecru_contact_link | default: '/pages/demande-particuliere'
  assign moq_texte = settings.ecru_moq_texte | default: '[À définir]'
  assign lignes_moq = settings.ecru_moq | newline_to_br | split: '<br />'
  assign lignes_couleurs = settings.ecru_couleurs | newline_to_br | split: '<br />'

  assign finish = 'metal'
  assign color = '#0d0d0c'
  for value in current.options
    assign v = value | downcase | strip
    if v contains 'pvc'
      assign finish = 'mat'
    endif
    for l in lignes_couleurs
      assign parts = l | split: ':'
      assign k = parts[0] | strip | downcase
      if k == v and parts[1] != blank
        assign color = parts[1] | strip
      endif
    endfor
  endfor
  assign ink = '#e9e4d8'
  assign c = color | color_brightness
  if c > 150
    assign ink = '#121211'
  endif

  assign palette = 'Noir profond:#0d0d0c|Anthracite:#2b2b2a|Graphite:#4a4a48|Crème:#e9e4d8|Ivoire:#f3efe6|Sable:#cdbb9a|Bordeaux:#5a1a22|Vert anglais:#1f3a2e|Bleu nuit:#1b2440|Or:#b8975a|Argent:#c9c8c4|Rose poudré:#d8b4ac' | split: '|'
  assign palette_marquage = 'Crème:#e9e4d8|Blanc:#f7f5f0|Noir:#121211|Or:#c2a165|Argent:#c9c8c4' | split: '|'
-%}

<section
  class="ecru-section ecru-produit"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  data-ecru-produit
>
  <div class="ecru-conteneur ecru-produit__grille">
    <div class="ecru-produit__visuel">
      {%- render 'ecru-carte', id: uid, color: color, ink: ink, finish: finish, alt: product.title, compact: true -%}
      <div class="ecru-vues" role="group" aria-label="Point de vue">
        <button type="button" class="ecru-vues__btn" data-ecru-vue="recto">Recto</button>
        <button type="button" class="ecru-vues__btn" data-ecru-vue="verso">Verso</button>
        <button type="button" class="ecru-vues__btn" data-ecru-vue="profil">Profil</button>
        <button type="button" class="ecru-vues__btn" data-ecru-vue="auto" aria-pressed="true">Rotation</button>
      </div>
      <p class="ecru-produit__mention">
        <span data-ecru-legende>{{ current.options | join: ' · ' }}</span>
        · 85,6 × 54 mm · Rendu indicatif
      </p>
    </div>

    <div class="ecru-produit__infos">
      {%- if product.type != blank -%}
        <p class="ecru-surtitre">{{ product.type | escape }}</p>
      {%- endif -%}
      <h1 class="ecru-titre">{{ product.title | escape }}</h1>
      <p class="ecru-produit__format">Format carte bancaire · 85,6 × 54 mm</p>

      <div class="ecru-produit__prix">
        {%- render 'price', product: product, use_variant: true -%}
      </div>

      {%- form 'product', product, id: 'form-produit', class: 'ecru-produit__form', novalidate: 'novalidate', data-ecru-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-ecru-variant>

        {%- assign etape = 0 -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign etape = etape | plus: 1
              assign nom_option = option.name | downcase
              assign est_couleur = false
              if nom_option contains 'couleur' or nom_option contains 'color' or nom_option contains 'modèle' or nom_option contains 'modele'
                assign est_couleur = true
              endif
              assign est_matiere = false
              if nom_option contains 'mati'
                assign est_matiere = true
              endif
            -%}
            <fieldset class="ecru-option{% if est_couleur %} ecru-option--couleur{% endif %}{% if est_matiere %} ecru-option--matiere{% endif %}">
              <legend>
                <span class="ecru-option__etape" aria-hidden="true">0{{ etape }}</span>
                {{ option.name | escape }}
                {%- if est_couleur -%}
                  <span class="ecru-option__valeur" data-ecru-valeur="{{ option.position }}">{{ option.selected_value | escape }}</span>
                {%- endif -%}
              </legend>
              <div class="ecru-option__choix">
                {%- for value in option.values -%}
                  {%- liquid
                    assign oid = uid | append: '-' | append: option.position | append: '-' | append: forloop.index
                    assign vb = value | downcase | strip
                    assign teinte = ''
                    for l in lignes_couleurs
                      assign parts = l | split: ':'
                      assign k = parts[0] | strip | downcase
                      if k == vb
                        assign teinte = parts[1] | strip
                      endif
                    endfor
                    assign genre = 'teinte'
                    if vb contains 'design'
                      assign genre = 'design'
                    elsif vb contains 'mesure' or vb contains 'custom' or vb contains 'personnal'
                      assign genre = 'palette'
                    endif
                  -%}
                  <input
                    type="radio"
                    id="{{ oid }}"
                    name="option{{ option.position }}"
                    value="{{ value | escape }}"
                    data-position="{{ option.position }}"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >
                  {%- if est_couleur -%}
                    <label for="{{ oid }}" class="ecru-pastille ecru-pastille--{{ genre }}" title="{{ value | escape }}">
                      <span class="ecru-pastille__teinte" style="--teinte: {{ teinte | default: '#2a2926' }}" aria-hidden="true">
                        {%- if genre == 'design' -%}
                          <svg viewBox="0 0 20 20" width="16" height="16"><path d="M4 16l1-4 8-8 3 3-8 8-4 1z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
                        {%- elsif genre == 'palette' -%}
                          <svg viewBox="0 0 20 20" width="16" height="16"><path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
                        {%- endif -%}
                      </span>
                      <span class="ecru-pastille__nom">{{ value | escape }}</span>
                    </label>
                  {%- elsif est_matiere -%}
                    <label for="{{ oid }}" class="ecru-matiere-choix">
                      <span class="ecru-matiere-choix__nom">{{ value | escape }}</span>
                    </label>
                  {%- else -%}
                    <label for="{{ oid }}">{{ value | escape }}</label>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if est_couleur -%}
                <p class="ecru-perso__note" data-ecru-note="standard">Cartes vierges, sans écriture. Pour un texte ou un logo, choisissez Design sur mesure.</p>
                <p class="ecru-perso__note" data-ecru-note="palette" hidden>La teinte de votre choix, sans écriture. Pour un texte ou un logo, choisissez Design sur mesure.</p>

                {%- comment -%} Couleur sur mesure : palette {%- endcomment -%}
                <div class="ecru-panneau" data-ecru-panneau="palette" hidden>
                  <p class="ecru-panneau__titre">Teinte de la carte</p>
                  {%- render 'ecru-palette', cible: 'fond-palette', teintes: palette, libre: '#5a1a22', label: 'Teinte de la carte' -%}
                  <input type="hidden" name="properties[Couleur sur mesure]" value="" data-ecru-champ="fond-palette" disabled>
                  <p class="ecru-champ__aide">Teinte choisie : <strong data-ecru-affiche="fond-palette">—</strong>. Nous ajustons la teinte exacte avec vous.</p>
                </div>

                {%- comment -%} Design sur mesure : éditeur intégré {%- endcomment -%}
                <div class="ecru-panneau ecru-createur" data-ecru-panneau="design" hidden>
                  <p class="ecru-panneau__titre">Composez votre carte</p>

                  <div class="ecru-editeur" data-ecru-editeur aria-label="Recto de la carte, à composer" role="group">
                    <div class="ecru-editeur__nfc" aria-hidden="true"><span>NFC</span></div>
                    <div class="ecru-editeur__guide ecru-editeur__guide--v" aria-hidden="true"></div>
                    <div class="ecru-editeur__guide ecru-editeur__guide--h" aria-hidden="true"></div>
                  </div>
                  <p class="ecru-champ__aide">Faites glisser les éléments. Au clavier : flèches pour déplacer, Suppr pour retirer.</p>

                  <div class="ecru-editeur__outils">
                    <button type="button" class="ecru-outil" data-ecru-ajout-texte>+ Texte</button>
                    <input
                      id="{{ uid }}-logo"
                      class="ecru-outil__fichier"
                      type="file"
                      name="properties[Logo]"
                      accept="image/png,image/jpeg,image/svg+xml"
                      data-ecru-fichier
                      disabled
                    >
                    <label for="{{ uid }}-logo" class="ecru-outil">+ Logo</label>
                    <span class="ecru-fichier__nom" data-ecru-fichier-nom></span>
                  </div>

                  <div class="ecru-editeur__reglages" data-ecru-reglages hidden>
                    <div class="ecru-champ" data-ecru-reglage-texte>
                      <label for="{{ uid }}-texte">Texte</label>
                      <input id="{{ uid }}-texte" type="text" maxlength="40" data-ecru-el-texte disabled>
                    </div>
                    <div class="ecru-demande__ligne">
                      <div class="ecru-champ">
                        <label for="{{ uid }}-taille">Taille</label>
                        <input id="{{ uid }}-taille" type="range" min="3" max="60" step="1" value="12" data-ecru-el-taille disabled>
                      </div>
                      <div class="ecru-champ" data-ecru-reglage-style>
                        <label for="{{ uid }}-style">Style</label>
                        <select id="{{ uid }}-style" data-ecru-el-style disabled>
                          <option value="display">Titre</option>
                          <option value="body">Texte</option>
                        </select>
                      </div>
                    </div>
                    <div class="ecru-editeur__actions">
                      <button type="button" class="ecru-outil" data-ecru-el-centrer>Centrer</button>
                      <button type="button" class="ecru-outil" data-ecru-el-supprimer>Retirer</button>
                    </div>
                  </div>

                  <p class="ecru-champ__titre">Fond</p>
                  {%- render 'ecru-palette', cible: 'fond', teintes: palette, libre: '#1b2440', label: 'Couleur du fond' -%}
                  <input type="hidden" name="properties[Fond]" value="#0d0d0c" data-ecru-champ="fond" disabled>

                  <p class="ecru-champ__titre">Marquage</p>
                  {%- render 'ecru-palette', cible: 'relief', teintes: palette_marquage, libre: '#c2a165', label: 'Couleur du texte et du logo' -%}
                  <input type="hidden" name="properties[Marquage]" value="#e9e4d8" data-ecru-champ="relief" disabled>

                  <input type="hidden" name="properties[Maquette]" value="" data-ecru-maquette disabled>
                  <input type="hidden" name="properties[_maquette]" value="" data-ecru-maquette-json disabled>
                </div>
              {%- endif -%}

              {%- if forloop.last -%}
                <p class="ecru-option__aide">
                  Minimum de commande :
                  <strong data-ecru-moq>{{ moq_texte | escape }}</strong>
                </p>
              {%- endif -%}
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        {%- if section.settings.show_perso -%}
          {%- assign etape = etape | plus: 1 -%}
          <fieldset class="ecru-option ecru-perso">
            <legend>
              <span class="ecru-option__etape" aria-hidden="true">0{{ etape }}</span>
              Précisions
            </legend>
            {%- if product.tags contains 'simple' -%}
              <div class="ecru-champ">
                <label for="{{ uid }}-lien">Lien à ouvrir</label>
                <input id="{{ uid }}-lien" type="url" name="properties[Lien]" placeholder="https://votre-site.fr" inputmode="url">
                <p class="ecru-champ__aide">La page qui s'ouvre quand on approche la carte du téléphone.</p>
              </div>
            {%- endif -%}
            <div class="ecru-champ">
              <label for="{{ uid }}-demande">Votre demande</label>
              <textarea id="{{ uid }}-demande" name="properties[Demande]" rows="3" placeholder="Une précision sur votre commande…"></textarea>
            </div>
          </fieldset>
        {%- endif -%}

        <div class="ecru-produit__achat">
          <div class="ecru-produit__quantite">
            <button type="button" data-ecru-qte="-1" aria-label="Retirer une carte">−</button>
            <label class="visually-hidden" for="{{ uid }}-qte">Quantité</label>
            <input id="{{ uid }}-qte" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-ecru-quantite>
            <button type="button" data-ecru-qte="1" aria-label="Ajouter une carte">+</button>
          </div>
          <button
            type="submit"
            class="ecru-bouton"
            data-ecru-ajout
            {% unless current.available %}
              disabled
            {% endunless %}
          >
            {%- if current.available -%}
              {{ section.settings.add_label | escape }}
            {%- else -%}
              Indisponible
            {%- endif -%}
          </button>
        </div>
        <a class="ecru-bouton ecru-bouton--ligne ecru-produit__contact" href="{{ contact }}?produit={{ product.title | url_encode }}">
          {{- section.settings.contact_label | escape -}}
        </a>
        <p class="ecru-produit__erreur" role="status" aria-live="polite" data-ecru-statut></p>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="ecru-produit__description rte">{{ product.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="ecru-produit__details ecru-faq">
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title | escape }}</summary>
              <div class="ecru-faq__reponse">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-ecru-donnees>
    {
      "variants": {{ product.variants | json }},
      "moq": {
        {%- assign premier = true -%}
        {%- for l in lignes_moq -%}
          {%- assign parts = l | split: ':' -%}
          {%- assign k = parts[0] | strip | downcase -%}
          {%- if k != blank -%}
            {%- assign q = parts[1] | strip | plus: 0 -%}
            {%- unless premier %},{% endunless -%}
            {{ k | json }}: {{ q }}
            {%- assign premier = false -%}
          {%- endif -%}
        {%- endfor -%}
      },
      "couleurs": {
        {%- assign premier = true -%}
        {%- for l in lignes_couleurs -%}
          {%- assign parts = l | split: ':' -%}
          {%- assign k = parts[0] | strip | downcase -%}
          {%- if k != blank and parts[1] != blank -%}
            {%- unless premier %},{% endunless -%}
            {{ k | json }}: {{ parts[1] | strip | json }}
            {%- assign premier = false -%}
          {%- endif -%}
        {%- endfor -%}
      },
      "moqTexte": {{ moq_texte | json }},
      "ajout": {{ section.settings.add_label | json }}
    }
  </script>
</section>

<script src="{{ 'ecru-configurateur.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Produit ECRU",
  "tag": "div",
  "class": "section-ecru-produit",
  "settings": [
    { "type": "header", "content": "Commande" },
    { "type": "checkbox", "id": "show_perso", "label": "Afficher les précisions (lien, demande)", "default": true },
    { "type": "text", "id": "add_label", "label": "Ajouter au panier", "default": "Ajouter au panier" },
    { "type": "text", "id": "contact_label", "label": "Demande particulière", "default": "Demande particulière" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "details",
      "name": "Détail repliable",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Comment ça marche" },
        { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Vos clients approchent la carte de leur téléphone. La page s'ouvre. Sans application.</p>" }
      ]
    }
  ]
}
{% endschema %}
