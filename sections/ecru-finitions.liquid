{%- comment -%}
  ECRU — Les finitions du métal : une vraie carte 3D qui tourne (le chrome ne se lit qu'en mouvement).
  Survoler ou toucher un nom change la finition de la carte. Sans 3D, l'image de secours s'affiche.
{%- endcomment -%}
<section
  class="ecru-section ecru-finitions"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
>
  <div class="ecru-conteneur ecru-finitions__grille">
    <div class="ecru-finitions__texte">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="titre-{{ section.id }}" class="ecru-titre ecru-reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="ecru-texte ecru-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <ul class="ecru-finitions__liste" role="list" data-ecru-finitions>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <button
              type="button"
              class="ecru-finitions__choix ecru-finitions__choix--{{ block.settings.visual }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-ecru-finition-vue="{{ forloop.index0 }}"
              data-ecru-finition="{{ block.settings.visual }}"
            >
              <span class="ecru-finitions__nom">{{ block.settings.title | escape }}</span>
              <span class="ecru-finitions__desc">{{ block.settings.text | escape }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank -%}
        <div class="ecru-actions">
          <a class="ecru-bouton" href="{{ section.settings.button_link | default: '/products/cartes-sur-mesure' }}">{{ section.settings.button_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>

    <div class="ecru-finitions__visuel">
      {%- assign premiere = section.blocks.first.settings.visual | default: 'chrome' -%}
      {%- assign marque = section.settings.card_text | default: 'ECRU' | strip | json -%}
      {%- assign elements = '[{"t":"text","v":' | append: marque | append: ',"x":0.37,"y":0.79,"s":0.25,"f":"display","a":"left","k":-0.01}]' -%}
      {%- render 'ecru-carte',
        id: 'finitions-carte',
        elements: elements,
        color: '#c9c7c2',
        ink: '#121211',
        finish: premiere,
        alt: 'Carte ECRU en métal, qui tourne pour montrer sa finition'
      -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var liste = document.querySelector('[data-ecru-finitions]');
    if (!liste) return;
    var section = liste.closest('.ecru-finitions');
    var boutons = liste.querySelectorAll('[data-ecru-finition-vue]');
    var carte = section.querySelector('[data-ecru-carte]');
    function montrer(i) {
      var choisi = null;
      boutons.forEach(function (b) {
        var actif = b.dataset.ecruFinitionVue === i;
        b.setAttribute('aria-pressed', actif ? 'true' : 'false');
        if (actif) choisi = b.dataset.ecruFinition;
      });
      // La carte garde sa rotation : seule la matière change
      if (carte && choisi) {
        var look = { finish: choisi };
        carte.__ecruLook = Object.assign(carte.__ecruLook || {}, look);
        carte.dispatchEvent(new CustomEvent('ecru:card-update', { detail: look }));
      }
    }
    boutons.forEach(function (b) {
      b.addEventListener('click', function () {
        montrer(b.dataset.ecruFinitionVue);
      });
      // Au survol, la carte change déjà : on compare d'un coup d'œil
      b.addEventListener('pointerenter', function (e) {
        if (e.pointerType === 'mouse') montrer(b.dataset.ecruFinitionVue);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Finitions ECRU",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Métal" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trois finitions. Une seule signature." },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Composer ma carte" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "card_text", "label": "Texte sur la carte", "default": "ECRU" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "finition",
      "name": "Finition",
      "settings": [
        { "type": "text", "id": "title", "label": "Nom", "default": "Satiné" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "select", "id": "visual", "label": "Finition", "default": "chrome", "options": [
          { "value": "chrome", "label": "Chromé" },
          { "value": "irise", "label": "Irisé" },
          { "value": "metal", "label": "Satiné" }
        ], "info": "Finition montrée sur la carte 3D" }
      ]
    }
  ],
  "presets": [{ "name": "Finitions ECRU" }]
}
{% endschema %}
