{%- comment -%}
  ECRU — Carte 3D. Section réutilisable (héro, pages produit, configurateur).
  La scène three.js (assets/ecru-carte-3d.js) n'est chargée qu'à l'approche de la section.
  Sans WebGL, l'image fixe reste affichée.
{%- endcomment -%}
{%- liquid
  assign card_text = section.settings.card_text | default: 'ECRU' | strip | upcase
  assign uid = 'ecru-carte-' | append: section.id
  assign heading_tag = 'h2'
  if section.settings.heading_h1
    assign heading_tag = 'h1'
  endif
-%}

{%- style -%}
  @font-face {
    font-family: 'Archivo Black';
    src: url('{{ 'archivo-black.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  #{{ uid }} {
    --ecru-pad-top: {{ section.settings.padding_top }}px;
    --ecru-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="{{ uid }}"
  class="ecru-carte{% if section.settings.show_text %} ecru-carte--texte{% endif %}"
  data-ecru-carte
  data-module="{{ 'ecru-carte-3d.js' | asset_url }}"
  data-font="{{ 'archivo-black.woff2' | asset_url }}"
  data-text="{{ card_text | escape }}"
  data-color="{{ section.settings.card_color }}"
  data-ink="{{ section.settings.ink_color }}"
  aria-labelledby="{{ uid }}-titre"
>
  <div class="ecru-carte__inner">
    {%- if section.settings.show_text -%}
      <div class="ecru-carte__texte">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ecru-carte__surtitre">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <{{ heading_tag }} id="{{ uid }}-titre" class="ecru-carte__titre">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- if section.settings.subheading != blank -%}
          <p class="ecru-carte__sous-titre">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- else -%}
      <h2 id="{{ uid }}-titre" class="visually-hidden">{{ section.settings.a11y_label | escape }}</h2>
    {%- endif -%}

    <div class="ecru-carte__scene">
      <div class="ecru-carte__vue" data-ecru-stage>
      <div class="ecru-carte__affiche">
        {%- if section.settings.poster != blank -%}
          {{
            section.settings.poster
            | image_url: width: 1800
            | image_tag:
              widths: '600, 900, 1200, 1800',
              sizes: '(min-width: 990px) 70vw, 100vw',
              alt: section.settings.a11y_label,
              fetchpriority: 'high',
              class: 'ecru-carte__affiche-img'
          }}
        {%- else -%}
          <img
            class="ecru-carte__affiche-img"
            src="{{ 'ecru-carte-secours.webp' | asset_url }}"
            alt="{{ section.settings.a11y_label | escape }}"
            width="1600"
            height="1052"
            fetchpriority="high"
            decoding="async"
          >
        {%- endif -%}
      </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="ecru-carte__avantages" id="{{ uid }}-avantages" role="list">
          {%- for block in section.blocks -%}
            <li class="ecru-carte__avantage" {{ block.shopify_attributes }}>
              <span class="ecru-carte__fleche" aria-hidden="true"></span>
              <span class="ecru-carte__libelle">{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <button
        type="button"
        class="ecru-carte__bascule"
        aria-expanded="false"
        aria-controls="{{ uid }}-avantages"
      >
        <span class="ecru-carte__bascule-ouvrir">{{ section.settings.toggle_label | escape }}</span>
        <span class="ecru-carte__bascule-fermer">Masquer</span>
      </button>
    {%- endif -%}

    {%- if section.settings.show_text and section.settings.button_label != blank -%}
      <div class="ecru-carte__actions">
        <a
          class="ecru-bouton"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ecru-carte {
    --ecru-bg: #070707;
    --ecru-surface: #121211;
    --ecru-border: #2a2926;
    --ecru-text: #e9e4d8;
    --ecru-muted: #a29d92;
    --ecru-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --ecru-card-w: min(74%, 82.4cqh);
    position: relative;
    background: var(--ecru-bg);
    color: var(--ecru-text);
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    padding: var(--ecru-pad-top) 0 var(--ecru-pad-bottom);
    overflow: hidden;
  }
  .ecru-carte__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ecru-carte__texte {
    text-align: center;
    max-width: 52rem;
  }
  .ecru-carte__surtitre {
    margin: 0 0 1.6rem;
    font-size: 1.1rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ecru-muted);
  }
  .ecru-carte__titre {
    margin: 0;
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.92;
    font-size: clamp(3.4rem, 7.4vw, 8.8rem);
    color: var(--ecru-text);
  }
  .ecru-carte__sous-titre {
    margin: 2rem auto 0;
    max-width: 34rem;
    color: var(--ecru-muted);
    font-size: 1.6rem;
    line-height: 1.6;
  }

  /* Scène : la hauteur fixe le cadrage, identique pour la 3D et l'image fixe */
  .ecru-carte__scene {
    position: relative;
    width: 100%;
    container-type: inline-size;
  }
  .ecru-carte__vue {
    position: relative;
    width: 100%;
    height: clamp(420px, 52vw, 720px);
    container-type: size;
    touch-action: pan-y;
  }
  .ecru-carte--texte .ecru-carte__vue {
    height: clamp(380px, 46vw, 640px);
  }
  .ecru-carte__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.4s var(--ecru-ease);
  }
  .ecru-carte.is-ready .ecru-carte__canvas {
    opacity: 1;
  }
  .ecru-carte__affiche {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 1.4s var(--ecru-ease);
  }
  .ecru-carte.is-ready .ecru-carte__affiche {
    opacity: 0;
  }
  /* L'image de secours est cadrée carte = 62,5 % de sa largeur */
  .ecru-carte__affiche-img {
    width: calc(var(--ecru-card-w) / 0.625);
    max-width: none;
    height: auto;
  }

  /* Avantages : flèches fines vers la carte */
  .ecru-carte__avantages {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ecru-carte__avantage {
    --l: 11cqw;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .ecru-carte__avantage:nth-child(1) { --x: 35%; --y: 34%; --a: 200deg; }
  .ecru-carte__avantage:nth-child(2) { --x: 32%; --y: 52%; --a: 180deg; }
  .ecru-carte__avantage:nth-child(3) { --x: 36%; --y: 67%; --a: 160deg; }
  .ecru-carte__avantage:nth-child(4) { --x: 65%; --y: 36%; --a: -18deg; }
  .ecru-carte__avantage:nth-child(5) { --x: 65%; --y: 65%; --a: 18deg; }
  .ecru-carte__fleche {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--l);
    height: 1px;
    background: linear-gradient(90deg, var(--ecru-text), rgba(233, 228, 216, 0.35));
    transform-origin: 0 50%;
    transform: rotate(var(--a)) scaleX(0);
    transition: transform 1.1s var(--ecru-ease);
  }
  /* Pointe de flèche côté carte */
  .ecru-carte__fleche::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -3px;
    width: 7px;
    height: 7px;
    border-left: 1px solid var(--ecru-text);
    border-bottom: 1px solid var(--ecru-text);
    transform: rotate(45deg);
  }
  .ecru-carte__libelle {
    position: absolute;
    left: calc(cos(var(--a)) * (var(--l) + 14px));
    top: calc(sin(var(--a)) * (var(--l) + 14px));
    transform: translate(0, -50%);
    white-space: nowrap;
    font-size: clamp(1.2rem, 1.05vw, 1.5rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ecru-text);
    opacity: 0;
    transition: opacity 1s var(--ecru-ease);
  }
  .ecru-carte__avantage:nth-child(-n + 3) .ecru-carte__libelle {
    transform: translate(-100%, -50%);
    text-align: right;
  }
  .ecru-carte__avantage:nth-child(2) .ecru-carte__fleche,
  .ecru-carte__avantage:nth-child(2) .ecru-carte__libelle { transition-delay: 0.08s; }
  .ecru-carte__avantage:nth-child(3) .ecru-carte__fleche,
  .ecru-carte__avantage:nth-child(3) .ecru-carte__libelle { transition-delay: 0.16s; }
  .ecru-carte__avantage:nth-child(4) .ecru-carte__fleche,
  .ecru-carte__avantage:nth-child(4) .ecru-carte__libelle { transition-delay: 0.24s; }
  .ecru-carte__avantage:nth-child(5) .ecru-carte__fleche,
  .ecru-carte__avantage:nth-child(5) .ecru-carte__libelle { transition-delay: 0.32s; }

  .ecru-carte.is-open .ecru-carte__fleche {
    transform: rotate(var(--a)) scaleX(1);
  }
  .ecru-carte.is-open .ecru-carte__libelle {
    opacity: 1;
    transition-delay: 0.5s;
  }

  .ecru-carte__bascule {
    margin-top: 1.2rem;
    padding: 1.2rem 2.2rem;
    min-height: 44px;
    background: transparent;
    border: 1px solid var(--ecru-border);
    border-radius: 999px;
    color: var(--ecru-muted);
    font: inherit;
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.6s var(--ecru-ease), border-color 0.6s var(--ecru-ease);
  }
  .ecru-carte__bascule:hover,
  .ecru-carte__bascule:focus-visible {
    color: var(--ecru-text);
    border-color: var(--ecru-muted);
  }
  .ecru-carte__bascule:focus-visible,
  .ecru-bouton:focus-visible {
    outline: 1px solid var(--ecru-text);
    outline-offset: 4px;
  }
  .ecru-carte__bascule-fermer,
  .ecru-carte.is-open .ecru-carte__bascule-ouvrir { display: none; }
  .ecru-carte.is-open .ecru-carte__bascule-fermer { display: inline; }

  .ecru-carte__actions {
    margin-top: 2.4rem;
  }
  .ecru-bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 3.2rem;
    background: var(--ecru-text);
    color: var(--ecru-bg);
    border: 1px solid var(--ecru-text);
    border-radius: 999px;
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.7s var(--ecru-ease), color 0.7s var(--ecru-ease);
  }
  .ecru-bouton:hover {
    background: transparent;
    color: var(--ecru-text);
  }

  /* Mobile et tablette : les avantages passent sous la carte, en liste */
  @media (max-width: 899px) {
    .ecru-carte__inner {
      padding: 0;
    }
    .ecru-carte__texte {
      padding: 0 16px;
    }
    .ecru-carte__vue,
    .ecru-carte--texte .ecru-carte__vue {
      height: clamp(340px, 92vw, 560px);
    }
    .ecru-carte__avantages {
      display: grid;
      gap: 1.1rem;
      justify-items: center;
      max-height: 0;
      overflow: hidden;
      transition: max-height 1.2s var(--ecru-ease), padding 1.2s var(--ecru-ease);
    }
    .ecru-carte__avantage {
      position: static;
      width: auto;
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
    }
    .ecru-carte__fleche {
      position: relative;
      width: 1px;
      height: 14px;
      background: var(--ecru-muted);
      transform: none;
      opacity: 0;
      transition: opacity 1s var(--ecru-ease);
    }
    .ecru-carte__fleche::before {
      left: -3px;
      top: 0;
      transform: rotate(135deg);
    }
    .ecru-carte__libelle {
      position: static;
      transform: none !important;
      font-size: 1.2rem;
      opacity: 0;
    }
    .ecru-carte.is-open .ecru-carte__avantages {
      max-height: 40rem;
      padding: 0.4rem 0 1.2rem;
    }
    .ecru-carte.is-open .ecru-carte__fleche { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ecru-carte *,
    .ecru-carte *::before {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var loaded = {};

    function setOpen(el, open) {
      el.classList.toggle('is-open', open);
      var btn = el.querySelector('.ecru-carte__bascule');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      el.dispatchEvent(new CustomEvent('ecru:avantages', { detail: open }));
    }

    function init(el) {
      if (!el || el.dataset.ecruInit) return;
      el.dataset.ecruInit = '1';
      var stage = el.querySelector('[data-ecru-stage]');
      var btn = el.querySelector('.ecru-carte__bascule');
      var pinned = false;

      if (btn) {
        btn.addEventListener('click', function () {
          pinned = !el.classList.contains('is-open');
          setOpen(el, pinned);
        });
      }
      if (stage) {
        stage.addEventListener('pointerenter', function (e) {
          if (e.pointerType === 'mouse' && window.innerWidth >= 900) setOpen(el, true);
        });
        stage.addEventListener('pointerleave', function (e) {
          if (e.pointerType === 'mouse' && !pinned) setOpen(el, false);
        });
      }

      var saveData = navigator.connection && navigator.connection.saveData;
      if (saveData || !('IntersectionObserver' in window)) return;

      var io = new IntersectionObserver(
        function (entries) {
          if (!entries[0].isIntersecting) return;
          io.disconnect();
          var url = el.dataset.module;
          var p = loaded[url] || (loaded[url] = import(url));
          p.then(function (m) {
            return m.mount(el);
          }).catch(function () {
            el.classList.add('is-fallback');
          });
        },
        { rootMargin: '300px 0px' }
      );
      io.observe(el);
    }

    function initAll(root) {
      (root || document).querySelectorAll('[data-ecru-carte]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initAll();
      });
    } else {
      initAll();
    }
    document.addEventListener('shopify:section:load', function (e) {
      initAll(e.target);
    });
    document.addEventListener('shopify:section:unload', function (e) {
      var el = e.target.querySelector('[data-ecru-carte]');
      if (el && el.__ecru) el.__ecru.destroy();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Carte 3D ECRU",
  "tag": "div",
  "class": "section-ecru-carte",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Carte"
    },
    {
      "type": "text",
      "id": "card_text",
      "label": "Texte en relief",
      "default": "ECRU",
      "info": "18 caractères max. Affiché en majuscules."
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Couleur de la carte",
      "default": "#0d0d0c"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Couleur du relief",
      "default": "#e9e4d8"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Image fixe de secours",
      "info": "Affichée pendant le chargement et si la 3D n'est pas disponible. Par défaut : rendu de la carte noire."
    },
    {
      "type": "text",
      "id": "a11y_label",
      "label": "Description de la carte (accessibilité)",
      "default": "Carte ECRU noire mate, ECRU en relief au recto, symbole sans contact au verso."
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Bouton des avantages",
      "default": "Les avantages"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Afficher le titre et le bouton",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_h1",
      "label": "Titre principal de la page (h1)",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "ECRU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils reviennent. Naturellement."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Créer mes cartes"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "avantage",
      "name": "Avantage",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Ils reviennent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carte 3D ECRU",
      "blocks": [
        { "type": "avantage", "settings": { "text": "Ils reviennent" } },
        { "type": "avantage", "settings": { "text": "Une carte à leur nom" } },
        { "type": "avantage", "settings": { "text": "Sans application" } },
        { "type": "avantage", "settings": { "text": "Récompenses modifiables" } },
        { "type": "avantage", "settings": { "text": "Rapport chaque mois" } }
      ]
    }
  ]
}
{% endschema %}
