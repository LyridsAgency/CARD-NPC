{%- comment -%}
  ECRU — Héro avec la carte 3D (snippets/ecru-carte.liquid).
{%- endcomment -%}
{%- liquid
  assign uid = 'ecru-carte-' | append: section.id
  assign avantages = ''
  for block in section.blocks
    if block.settings.text != blank
      assign avantages = avantages | append: block.settings.text | append: '|'
    endif
  endfor
  comment
    Carte vierge, comme le produit réel ; un marquage discret en bas à droite si renseigné
  endcomment
  assign elements = '[]'
  if section.settings.card_text != blank
    assign marque = section.settings.card_text | strip | json
    assign elements = '[{"t":"text","v":' | append: marque | append: ',"x":0.9,"y":0.84,"s":0.06,"f":"display","a":"right"}]'
  endif
  assign heading_tag = 'h2'
  if section.settings.heading_h1
    assign heading_tag = 'h1'
  endif
-%}

<section
  class="ecru-section ecru-hero{% if section.settings.show_text %} ecru-hero--texte{% endif %}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="{{ uid }}-titre"
>
  <div class="ecru-hero__inner">
    {%- if section.settings.show_text -%}
      <div class="ecru-hero__texte">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <{{ heading_tag }} id="{{ uid }}-titre" class="ecru-titre ecru-hero__titre ecru-reveal">
          {{- section.settings.heading | escape -}}
        </{{ heading_tag }}>
        {%- if section.settings.subheading != blank -%}
          <p class="ecru-texte ecru-hero__sous-titre ecru-reveal">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- else -%}
      <h2 id="{{ uid }}-titre" class="visually-hidden">{{ section.settings.a11y_label | escape }}</h2>
    {%- endif -%}

    {%- render 'ecru-carte',
      id: uid,
      elements: elements,
      auto_open: section.settings.auto_open,
      color: section.settings.card_color,
      ink: section.settings.ink_color,
      finish: section.settings.finish,
      poster: section.settings.poster,
      alt: section.settings.a11y_label,
      avantages: avantages,
      toggle_label: section.settings.toggle_label
    -%}

    {%- if section.settings.show_text and section.settings.button_label != blank -%}
      <div class="ecru-hero__actions ecru-reveal">
        <a
          class="ecru-bouton"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carte 3D ECRU",
  "tag": "div",
  "class": "section-ecru-carte",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Carte"
    },
    {
      "type": "text",
      "id": "card_text",
      "label": "Marquage discret",
      "default": "ECRU",
      "info": "En bas à droite de la carte. Laisser vide pour une carte vierge."
    },
    {
      "type": "checkbox",
      "id": "auto_open",
      "label": "Afficher les avantages dès l'arrivée",
      "default": true
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Couleur de la carte",
      "default": "#0d0d0c"
    },
    {
      "type": "select",
      "id": "finish",
      "label": "Finition",
      "options": [
        { "value": "metal", "label": "Métal" },
        { "value": "mat", "label": "Mat (PVC)" }
      ],
      "default": "metal"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Couleur du relief",
      "default": "#e9e4d8"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Image fixe de secours",
      "info": "Affichée pendant le chargement et si la 3D n'est pas disponible."
    },
    {
      "type": "text",
      "id": "a11y_label",
      "label": "Description de la carte (accessibilité)",
      "default": "Carte NFC ECRU en métal noir mat, avec sa fenêtre NFC."
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Bouton des avantages",
      "default": "Les avantages"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Afficher le titre et le bouton",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_h1",
      "label": "Titre principal de la page (h1)",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Cartes NFC pour commerçants"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils reviennent. Naturellement."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Créer mes cartes"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "avantage",
      "name": "Avantage",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Un geste, sans application"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carte 3D ECRU",
      "blocks": [
        { "type": "avantage", "settings": { "text": "Un geste, sans application" } },
        { "type": "avantage", "settings": { "text": "À vos couleurs" } },
        { "type": "avantage", "settings": { "text": "Votre logo, où vous voulez" } },
        { "type": "avantage", "settings": { "text": "PVC ou métal" } },
        { "type": "avantage", "settings": { "text": "Format carte bancaire" } }
      ]
    }
  ]
}
{% endschema %}
