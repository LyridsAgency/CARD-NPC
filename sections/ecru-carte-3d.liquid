{%- comment -%}
  ECRU — Héro avec la carte 3D (snippets/ecru-carte.liquid).
{%- endcomment -%}
{%- liquid
  assign uid = 'ecru-carte-' | append: section.id
  assign avantages = ''
  for block in section.blocks
    if block.settings.text != blank
      assign avantages = avantages | append: block.settings.text | append: '|'
    endif
  endfor
  assign heading_tag = 'h2'
  if section.settings.heading_h1
    assign heading_tag = 'h1'
  endif
-%}

<section
  class="ecru-section ecru-hero{% if section.settings.show_text %} ecru-hero--texte{% endif %}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="{{ uid }}-titre"
>
  <div class="ecru-hero__inner">
    {%- if section.settings.show_text -%}
      <div class="ecru-hero__texte">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <{{ heading_tag }} id="{{ uid }}-titre" class="ecru-titre ecru-hero__titre ecru-reveal">
          {{- section.settings.heading | escape -}}
        </{{ heading_tag }}>
        {%- if section.settings.subheading != blank -%}
          <p class="ecru-texte ecru-hero__sous-titre ecru-reveal">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- else -%}
      <h2 id="{{ uid }}-titre" class="visually-hidden">{{ section.settings.a11y_label | escape }}</h2>
    {%- endif -%}

    {%- render 'ecru-carte',
      id: uid,
      text: section.settings.card_text,
      holder: section.settings.card_holder,
      tier: section.settings.card_tier,
      color: section.settings.card_color,
      ink: section.settings.ink_color,
      finish: section.settings.finish,
      poster: section.settings.poster,
      alt: section.settings.a11y_label,
      avantages: avantages,
      toggle_label: section.settings.toggle_label
    -%}

    {%- if section.settings.show_text and section.settings.button_label != blank -%}
      <div class="ecru-hero__actions ecru-reveal">
        <a
          class="ecru-bouton"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carte 3D ECRU",
  "tag": "div",
  "class": "section-ecru-carte",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Carte"
    },
    {
      "type": "text",
      "id": "card_text",
      "label": "Marque gravée",
      "default": "ECRU",
      "info": "En haut à gauche de la carte. 18 caractères max."
    },
    {
      "type": "text",
      "id": "card_holder",
      "label": "Nom du titulaire",
      "default": "Prénom Nom",
      "info": "Laisser vide pour ne pas l'afficher."
    },
    {
      "type": "text",
      "id": "card_tier",
      "label": "Niveau",
      "default": "Privilège"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Couleur de la carte",
      "default": "#0d0d0c"
    },
    {
      "type": "select",
      "id": "finish",
      "label": "Finition",
      "options": [
        { "value": "metal", "label": "Métal" },
        { "value": "mat", "label": "Mat (PVC)" }
      ],
      "default": "metal"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Couleur du relief",
      "default": "#e9e4d8"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Image fixe de secours",
      "info": "Affichée pendant le chargement et si la 3D n'est pas disponible."
    },
    {
      "type": "text",
      "id": "a11y_label",
      "label": "Description de la carte (accessibilité)",
      "default": "Carte ECRU en métal noir, au nom du client, avec le symbole sans contact."
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Bouton des avantages",
      "default": "Les avantages"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Afficher le titre et le bouton",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_h1",
      "label": "Titre principal de la page (h1)",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Cartes NFC pour commerçants"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils reviennent. Naturellement."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Créer mes cartes"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "avantage",
      "name": "Avantage",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Ils reviennent d'eux-mêmes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carte 3D ECRU",
      "blocks": [
        { "type": "avantage", "settings": { "text": "Ils reviennent d'eux-mêmes" } },
        { "type": "avantage", "settings": { "text": "Gravée à leur nom" } },
        { "type": "avantage", "settings": { "text": "Un geste, sans application" } },
        { "type": "avantage", "settings": { "text": "Récompenses à la carte" } },
        { "type": "avantage", "settings": { "text": "Vos chiffres chaque mois" } }
      ]
    }
  ]
}
{% endschema %}
