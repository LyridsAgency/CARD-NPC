{%- comment -%} ECRU — Pourquoi une carte change tout. {%- endcomment -%}
<section
  class="ecru-section ecru-avantages{% if section.settings.surface %} ecru-section--surface{% endif %}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
>
  <div class="ecru-conteneur">
    <header class="ecru-entete">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="titre-{{ section.id }}" class="ecru-titre ecru-reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="ecru-texte ecru-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="ecru-avantages__grille">
      {%- for block in section.blocks -%}
        <article class="ecru-avantage ecru-reveal" style="--d: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="ecru-avantage__num" aria-hidden="true">0{{ forloop.index }}</span>
          <h3 class="ecru-titre ecru-titre--s">{{ block.settings.title | escape }}</h3>
          <p class="ecru-texte">{{ block.settings.text | escape }}</p>
          {%- if block.settings.pour != blank -%}
            <p class="ecru-avantage__pour">{{ block.settings.pour | escape }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- assign publics = section.settings.publics | split: ',' -%}
    {%- if publics.size > 0 -%}
      <ul class="ecru-pour-qui ecru-reveal" role="list" aria-label="Pour qui">
        {%- for p in publics -%}
          <li>{{ p | strip | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Avantages ECRU",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Pourquoi une carte" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un geste. Tout change." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Une carte dans le portefeuille vaut mieux qu'une appli oubliée sur un téléphone." },
    { "type": "text", "id": "publics", "label": "Pour qui (séparés par des virgules)", "default": "Commerces de quartier, Restaurants, Salons, Boîtes de nuit, Festivals" },
    { "type": "checkbox", "id": "surface", "label": "Fond légèrement plus clair", "default": false },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "avantage",
      "name": "Avantage",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Ils reviennent" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "pour", "label": "Idéal pour" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avantages ECRU",
      "blocks": [
        { "type": "avantage", "settings": { "title": "La fidélité, sans effort", "text": "Chaque passage compte. Vos clients cumulent, vous récompensez. Ils reviennent, parce qu'ils ont une raison de le faire.", "pour": "Restaurants, cafés, salons" } },
        { "type": "avantage", "settings": { "title": "Votre marque, dans leur poche", "text": "Une carte gravée à votre nom, qu'on garde et qu'on montre. Votre commerce existe aussi en dehors de vos murs.", "pour": "Boutiques, instituts, clubs" } },
        { "type": "avantage", "settings": { "title": "On parle de vous", "text": "Un geste contre un téléphone, et votre page s'ouvre : avis, réseaux, programme, billetterie. Partager devient naturel.", "pour": "Festivals, soirées, événements" } }
      ]
    }
  ]
}
{% endschema %}
