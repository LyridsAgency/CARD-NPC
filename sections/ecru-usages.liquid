{%- comment -%} ECRU — Ce que la carte peut ouvrir : une liste sobre, des usages variés. {%- endcomment -%}
<section
  class="ecru-section ecru-usages{% if section.settings.surface %} ecru-section--surface{% endif %}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
>
  <div class="ecru-conteneur ecru-usages__grille">
    <header class="ecru-entete ecru-usages__entete">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="titre-{{ section.id }}" class="ecru-titre ecru-titre--m ecru-reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="ecru-texte ecru-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    <ol class="ecru-usages__liste" role="list">
      {%- for block in section.blocks -%}
        <li class="ecru-usage ecru-reveal" style="--d: {{ forloop.index0 | modulo: 3 }}" {{ block.shopify_attributes }}>
          <span class="ecru-usage__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h3 class="ecru-usage__titre">{{ block.settings.title | escape }}</h3>
          <p class="ecru-usage__texte">{{ block.settings.text | escape }}</p>
          {%- if block.settings.pour != blank -%}
            <p class="ecru-usage__pour">{{ block.settings.pour | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Usages ECRU",
  "tag": "div",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Une carte, vos usages" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Elle ouvre ce que vous voulez." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Un geste contre le téléphone, et la bonne page s'ouvre. À vous de choisir laquelle." },
    { "type": "checkbox", "id": "surface", "label": "Fond légèrement plus clair", "default": false },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "usage",
      "name": "Usage",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Votre site" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "pour", "label": "Idéal pour" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Usages ECRU",
      "blocks": [
        { "type": "usage", "settings": { "title": "Le menu", "text": "Toujours à jour, sans papier.", "pour": "Restaurants, cafés, bars" } },
        { "type": "usage", "settings": { "title": "Vos avis", "text": "Un geste, et le client laisse son avis.", "pour": "Commerces, salons" } },
        { "type": "usage", "settings": { "title": "Vos réseaux", "text": "On vous suit en une seconde.", "pour": "Boutiques, créateurs" } },
        { "type": "usage", "settings": { "title": "La fidélité", "text": "Ils cumulent, vous récompensez.", "pour": "Avec l’option fidélité" } },
        { "type": "usage", "settings": { "title": "Billetterie et accès", "text": "Entrées, programme, infos pratiques.", "pour": "Festivals, soirées" } },
        { "type": "usage", "settings": { "title": "Carte de visite", "text": "Vos coordonnées, enregistrées d'un geste.", "pour": "Indépendants, équipes" } },
        { "type": "usage", "settings": { "title": "Accueil et infos", "text": "Votre page d'accueil, vos infos pratiques.", "pour": "Hôtels, lieux, événements" } },
        { "type": "usage", "settings": { "title": "Votre site", "text": "N'importe quel lien, tout simplement.", "pour": "Tout le monde" } }
      ]
    }
  ]
}
{% endschema %}
