{%- comment -%} ECRU — Ce que la carte peut ouvrir : des usages variés, pas un seul. {%- endcomment -%}
<section
  class="ecru-section ecru-usages{% if section.settings.surface %} ecru-section--surface{% endif %}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
>
  <div class="ecru-conteneur">
    <header class="ecru-entete">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="titre-{{ section.id }}" class="ecru-titre ecru-reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="ecru-texte ecru-reveal">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    <ul class="ecru-usages__grille" role="list">
      {%- for block in section.blocks -%}
        <li class="ecru-usage ecru-reveal" style="--d: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <span class="ecru-usage__icone" aria-hidden="true">
            {%- case block.settings.icone -%}
              {%- when 'menu' -%}
                <svg viewBox="0 0 32 32"><path d="M9 5v22M6 5v7a3 3 0 0 0 6 0V5M22 27V5c-3 0-4 4-4 9h4"/></svg>
              {%- when 'avis' -%}
                <svg viewBox="0 0 32 32"><path d="M16 5l3.2 6.6 7.3 1-5.3 5.1 1.3 7.2L16 21.5l-6.5 3.4 1.3-7.2-5.3-5.1 7.3-1z"/></svg>
              {%- when 'reseaux' -%}
                <svg viewBox="0 0 32 32"><rect x="6" y="6" width="20" height="20" rx="6"/><circle cx="16" cy="16" r="4.5"/><circle cx="22" cy="10" r="0.8"/></svg>
              {%- when 'fidelite' -%}
                <svg viewBox="0 0 32 32"><path d="M16 27s-10-6-10-13a5.5 5.5 0 0 1 10-3 5.5 5.5 0 0 1 10 3c0 7-10 13-10 13z"/></svg>
              {%- when 'billet' -%}
                <svg viewBox="0 0 32 32"><path d="M5 10h22v4a2 2 0 0 0 0 4v4H5v-4a2 2 0 0 0 0-4z"/><path d="M19 10v12" stroke-dasharray="2 2"/></svg>
              {%- when 'contact' -%}
                <svg viewBox="0 0 32 32"><rect x="5" y="8" width="22" height="16" rx="2"/><circle cx="12" cy="15" r="3"/><path d="M8 21c1-2 2.5-3 4-3s3 1 4 3M19 13h5M19 17h4"/></svg>
              {%- when 'wifi' -%}
                <svg viewBox="0 0 32 32"><path d="M5 13a16 16 0 0 1 22 0M9 17a10 10 0 0 1 14 0M13 21a4 4 0 0 1 6 0"/><circle cx="16" cy="24.5" r="0.8"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32"><path d="M13 19l6-6M11 15l-3 3a4 4 0 0 0 6 6l3-3M21 17l3-3a4 4 0 0 0-6-6l-3 3"/></svg>
            {%- endcase -%}
          </span>
          <h3 class="ecru-usage__titre">{{ block.settings.title | escape }}</h3>
          <p class="ecru-usage__texte">{{ block.settings.text | escape }}</p>
          {%- if block.settings.pour != blank -%}
            <p class="ecru-usage__pour">{{ block.settings.pour | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Usages ECRU",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Une carte, vos usages" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Elle ouvre ce que vous voulez." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Un geste contre le téléphone, et la bonne page s'ouvre. À vous de choisir laquelle." },
    { "type": "checkbox", "id": "surface", "label": "Fond légèrement plus clair", "default": false },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "usage",
      "name": "Usage",
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Icône",
          "options": [
            { "value": "menu", "label": "Menu" },
            { "value": "avis", "label": "Avis" },
            { "value": "reseaux", "label": "Réseaux" },
            { "value": "fidelite", "label": "Fidélité" },
            { "value": "billet", "label": "Billet" },
            { "value": "contact", "label": "Contact" },
            { "value": "wifi", "label": "Wi-Fi" },
            { "value": "lien", "label": "Lien" }
          ],
          "default": "lien"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Votre site" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "pour", "label": "Idéal pour" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Usages ECRU",
      "blocks": [
        { "type": "usage", "settings": { "icone": "menu", "title": "Le menu", "text": "Toujours à jour, sans papier.", "pour": "Restaurants, cafés, bars" } },
        { "type": "usage", "settings": { "icone": "avis", "title": "Vos avis", "text": "Un geste, et le client laisse son avis.", "pour": "Commerces, salons" } },
        { "type": "usage", "settings": { "icone": "reseaux", "title": "Vos réseaux", "text": "On vous suit en une seconde.", "pour": "Boutiques, créateurs" } },
        { "type": "usage", "settings": { "icone": "fidelite", "title": "La fidélité", "text": "Ils cumulent, vous récompensez.", "pour": "Avec l'offre Fidélité" } },
        { "type": "usage", "settings": { "icone": "billet", "title": "Billetterie et accès", "text": "Entrées, programme, infos pratiques.", "pour": "Festivals, soirées" } },
        { "type": "usage", "settings": { "icone": "contact", "title": "Carte de visite", "text": "Vos coordonnées, enregistrées d'un geste.", "pour": "Indépendants, équipes" } },
        { "type": "usage", "settings": { "icone": "wifi", "title": "Accueil et infos", "text": "Votre page d'accueil, vos infos pratiques.", "pour": "Hôtels, lieux, événements" } },
        { "type": "usage", "settings": { "icone": "lien", "title": "Votre site", "text": "N'importe quel lien, tout simplement.", "pour": "Tout le monde" } }
      ]
    }
  ]
}
{% endschema %}
