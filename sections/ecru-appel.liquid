{%- comment -%} ECRU — Appel final. {%- endcomment -%}
<section
  class="ecru-section ecru-appel"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="titre-{{ section.id }}"
>
  {%- comment -%} Traits de fond : les lignes de la carte, qui se dessinent lentement {%- endcomment -%}
  <svg class="ecru-appel__traits" viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    {%- for i in (0..7) -%}
      {%- assign y1 = i | times: 38 | plus: 140 -%}
      {%- assign y2 = 460 | minus: y1 | plus: 140 -%}
      <path style="--i: {{ i }}" d="M-40,{{ y1 }} C380,{{ y1 | minus: 120 }} 620,{{ y2 | plus: 160 }} 1040,{{ y2 }} S1360,{{ y1 | plus: 40 }} 1480,{{ y1 | minus: 30 }}"/>
    {%- endfor -%}
  </svg>
  <div class="ecru-conteneur">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ecru-surtitre ecru-reveal">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 id="titre-{{ section.id }}" class="ecru-titre ecru-reveal">{{ section.settings.heading | escape }}</h2>
    <div class="ecru-actions ecru-actions--centre ecru-reveal">
      {%- if section.settings.button_label != blank -%}
        <a class="ecru-bouton" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="ecru-bouton ecru-bouton--ligne" href="{{ section.settings.button_2_link | default: settings.ecru_contact_link | default: '/pages/demande-particuliere' }}">
          {{- section.settings.button_2_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appel final ECRU",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Menu, avis, réseaux, fidélité" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Tout tient dans une carte." },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Créer mes cartes" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button_2_label", "label": "Bouton secondaire", "default": "Demander un devis" },
    { "type": "url", "id": "button_2_link", "label": "Lien du bouton secondaire", "info": "Par défaut : la page Devis." },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 128 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 128 }
  ],
  "presets": [{ "name": "Appel final ECRU" }]
}
{% endschema %}
